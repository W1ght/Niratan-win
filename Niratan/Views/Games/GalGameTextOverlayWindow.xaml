<?xml version="1.0" encoding="utf-8" ?>
<Window x:Class="Niratan.Views.Games.GalGameTextOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:games="using:Niratan.Models.Games"
        xmlns:win2d="using:Microsoft.Graphics.Canvas.UI.Xaml">
    <Grid x:Name="RootGrid"
          Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
          Padding="0"
          PointerPressed="RootGridPointerPressed"
          PointerMoved="RootGridPointerMoved"
          PointerReleased="RootGridPointerReleased"
          PointerCanceled="RootGridPointerCanceled">
        <Border x:Name="Surface"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                BorderThickness="0"
                CornerRadius="0"
                PointerEntered="SurfacePointerEntered"
                PointerExited="SurfacePointerExited">
            <Grid RowDefinitions="48,*">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto,*">
                    <Border x:Name="LeftDragRegion"
                            Grid.Column="0"
                            Background="Transparent"
                            PointerPressed="DragRegionPointerPressed"
                            PointerMoved="DragRegionPointerMoved"
                            PointerReleased="DragRegionPointerReleased"
                            PointerCanceled="DragRegionPointerCanceled" />

                    <Grid Grid.Column="1" HorizontalAlignment="Center">
                        <Border x:Name="Grip"
                                Width="40"
                                Height="4"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="#A0FFFFFF"
                                CornerRadius="2" />
                        <StackPanel x:Name="ToolbarPanel"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    Visibility="Collapsed">
                            <Button x:Name="ReplayVoiceButton"
                                    Tag="replayVoice"
                                    Width="34"
                                    Height="34"
                                    Padding="0"
                                    AutomationProperties.Name="Replay voice"
                                    Click="ToolbarButtonClick">
                                <TextBlock Text="↻" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Button>
                            <Button x:Name="RecaptureVoiceButton"
                                    Tag="recaptureVoice"
                                    Width="34"
                                    Height="34"
                                    Padding="0"
                                    AutomationProperties.Name="Recapture voice"
                                    Click="ToolbarButtonClick">
                                <TextBlock Text="●" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Button>
                            <Button x:Name="FollowButton"
                                    Tag="toggleFollow"
                                    Width="34"
                                    Height="34"
                                    Padding="0"
                                    AutomationProperties.Name="Follow live"
                                    Click="ToolbarButtonClick">
                                <TextBlock Text="▶" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Button>
                            <Button x:Name="PassThroughButton"
                                    Tag="togglePassThrough"
                                    Width="34"
                                    Height="34"
                                    Padding="0"
                                    AutomationProperties.Name="Pass through"
                                    Click="ToolbarButtonClick">
                                <TextBlock Text="↗" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Button>
                            <Button x:Name="TransparencyButton"
                                    Tag="toggleTransparency"
                                    Width="34"
                                    Height="34"
                                    Padding="0"
                                    AutomationProperties.Name="Toggle transparency"
                                    Click="ToolbarButtonClick">
                                <TextBlock Text="◐" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Button>
                            <Button x:Name="LockButton"
                                    Tag="lock"
                                    Width="34"
                                    Height="34"
                                    Padding="0"
                                    AutomationProperties.Name="Lock position"
                                    Click="ToolbarButtonClick">
                                <TextBlock x:Name="LockGlyph" Text="🔓" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Button>
                            <Button x:Name="WorkbenchButton"
                                    Tag="openWorkbench"
                                    Width="34"
                                    Height="34"
                                    Padding="0"
                                    AutomationProperties.Name="Open capture workbench"
                                    Click="ToolbarButtonClick">
                                <TextBlock Text="▣" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Button>
                            <Button x:Name="TopmostButton"
                                    Tag="topmost"
                                    Width="34"
                                    Height="34"
                                    Padding="0"
                                    AutomationProperties.Name="Keep on top"
                                    Click="ToolbarButtonClick">
                                <TextBlock Text="📌" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Button>
                            <Button x:Name="CloseButton"
                                    Tag="close"
                                    Width="34"
                                    Height="34"
                                    Padding="0"
                                    AutomationProperties.Name="Close capture window"
                                    Click="ToolbarButtonClick">
                                <TextBlock Text="✕" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Border x:Name="RightDragRegion"
                            Grid.Column="2"
                            Background="Transparent"
                            PointerPressed="DragRegionPointerPressed"
                            PointerMoved="DragRegionPointerMoved"
                            PointerReleased="DragRegionPointerReleased"
                            PointerCanceled="DragRegionPointerCanceled" />
                </Grid>

                <Grid Grid.Row="1"
                      Margin="24,0,24,12">
                    <win2d:CanvasControl x:Name="CurrentTextCanvas"
                                         HorizontalAlignment="Stretch"
                                         VerticalAlignment="Stretch"
                                         IsHitTestVisible="True"
                                         Draw="CurrentTextCanvasDraw"
                                         PointerPressed="CurrentTextCanvasPointerPressed" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
