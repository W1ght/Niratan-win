<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog x:Class="Niratan.Views.Dialogs.NyaaImportDialog"
               x:Name="RootDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
               xmlns:converters="using:Niratan.Helpers.UI.Converters"
               xmlns:components="using:Niratan.ViewModels.Components"
               xmlns:nyaa="using:Niratan.Models.Nyaa"
               mc:Ignorable="d"
               x:Uid="NyaaDialog"
               Title="Nyaa resource import"
               CloseButtonText="Close"
               DefaultButton="Close">
    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMinWidth">980</x:Double>
        <x:Double x:Key="ContentDialogMaxWidth">1080</x:Double>
        <x:Double x:Key="ContentDialogMinHeight">680</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">760</x:Double>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </ContentDialog.Resources>

    <TabView Width="980"
             Height="590"
             IsAddTabButtonVisible="False">
        <TabViewItem x:Uid="NyaaSearchTab"
                     Header="Search"
                     IsClosable="False">
            <Grid RowDefinitions="Auto,Auto,Auto,*"
                  RowSpacing="12">
        <InfoBar x:Uid="NyaaLegalNotice"
                 Severity="Informational"
                 IsClosable="False"
                 IsOpen="True"
                 Title="Use only resources you are authorized to download"
                 Message="Niratan searches Nyaa's RSS feed, downloads through its built-in BitTorrent engine, then imports supported EPUB, audiobook/SRT, video, and sidecar subtitle files." />

        <Grid Grid.Row="1"
              ColumnDefinitions="*,150,150,150,Auto"
              ColumnSpacing="10">
            <TextBox x:Name="SearchBox"
                     x:Uid="NyaaSearchBox"
                     PlaceholderText="Title, release group, or keyword"
                     AutomationProperties.AutomationId="NyaaSearchBox"
                     Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     KeyDown="SearchBox_KeyDown" />
            <ComboBox Grid.Column="1"
                      ItemsSource="{x:Bind ViewModel.Categories, Mode=OneWay}"
                      DisplayMemberPath="DisplayName"
                      SelectedItem="{x:Bind ViewModel.SelectedCategory, Mode=TwoWay}" />
            <ComboBox Grid.Column="2"
                      x:Uid="NyaaResultFilterComboBox"
                      ItemsSource="{x:Bind ViewModel.ResultFilters, Mode=OneWay}"
                      DisplayMemberPath="DisplayName"
                      SelectedItem="{x:Bind ViewModel.SelectedResultFilter, Mode=TwoWay}" />
            <ComboBox Grid.Column="3"
                      x:Uid="NyaaResultSortComboBox"
                      ItemsSource="{x:Bind ViewModel.ResultSortOptions, Mode=OneWay}"
                      DisplayMemberPath="DisplayName"
                      SelectedItem="{x:Bind ViewModel.SelectedResultSort, Mode=TwoWay}" />
            <Button Grid.Column="4"
                    x:Uid="NyaaSearchButton"
                    Content="Search"
                    Style="{StaticResource AccentButtonStyle}"
                    AutomationProperties.AutomationId="NyaaSearchButton"
                    Command="{x:Bind ViewModel.SearchCommand}"
                    IsEnabled="{x:Bind ViewModel.CanSearch, Mode=OneWay}" />
        </Grid>

        <Grid Grid.Row="2"
              RowDefinitions="Auto,Auto"
              RowSpacing="8">
            <Grid ColumnDefinitions="Auto,*"
                  ColumnSpacing="8">
                <ProgressRing Width="18"
                              Height="18"
                              IsActive="{x:Bind ViewModel.IsSearching, Mode=OneWay}"
                              Visibility="{x:Bind ViewModel.IsSearching, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />
                <TextBlock Grid.Column="1"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="{x:Bind ViewModel.ResultSummary, Mode=OneWay}" />
            </Grid>
            <InfoBar Grid.Row="1"
                     Severity="Warning"
                     IsClosable="False"
                     IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                     Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />
        </Grid>

                <ListView Grid.Row="3"
                          MinHeight="360"
                          ItemsSource="{x:Bind ViewModel.Results, Mode=OneWay}"
                          SelectionMode="None">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="8" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="components:NyaaTorrentItemViewModel">
                    <Grid ColumnDefinitions="*,180"
                          ColumnSpacing="14"
                          Padding="4,6">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{x:Bind Title}"
                                       TextTrimming="CharacterEllipsis"
                                       Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="{x:Bind Metadata}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{x:Bind TrustLabel}"
                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                       Visibility="{x:Bind HasTrustLabel, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneTime}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1"
                                    Spacing="5">
                            <Button x:Uid="NyaaDownloadButton"
                                    Content="Download and import"
                                    HorizontalAlignment="Stretch"
                                    Command="{Binding ViewModel.DownloadAndImportCommand, ElementName=RootDialog}"
                                    CommandParameter="{x:Bind}"
                                    IsEnabled="{x:Bind CanDownload, Mode=OneWay}" />
                            <ProgressBar Minimum="0"
                                         Maximum="100"
                                         Value="{x:Bind ProgressPercent, Mode=OneWay}" />
                            <TextBlock FontSize="12"
                                       TextWrapping="Wrap"
                                       Text="{x:Bind Status, Mode=OneWay}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </TabViewItem>

        <TabViewItem Header="{x:Bind ViewModel.DownloadTabHeader, Mode=OneWay}"
                     IsClosable="False">
            <Grid RowDefinitions="Auto,*"
                  RowSpacing="10">
                <Grid ColumnDefinitions="220,220,*"
                      ColumnSpacing="10"
                      Padding="8,4,8,0">
                    <ComboBox x:Uid="NyaaDownloadFilterComboBox"
                              Header="Filter"
                              ItemsSource="{x:Bind ViewModel.DownloadFilters, Mode=OneWay}"
                              DisplayMemberPath="DisplayName"
                              SelectedItem="{x:Bind ViewModel.SelectedDownloadFilter, Mode=TwoWay}" />
                    <ComboBox Grid.Column="1"
                              x:Uid="NyaaDownloadSortComboBox"
                              Header="Sort"
                              ItemsSource="{x:Bind ViewModel.DownloadSortOptions, Mode=OneWay}"
                              DisplayMemberPath="DisplayName"
                              SelectedItem="{x:Bind ViewModel.SelectedDownloadSort, Mode=TwoWay}" />
                </Grid>

                <ListView Grid.Row="1"
                          ItemsSource="{x:Bind ViewModel.Downloads, Mode=OneWay}"
                          SelectionMode="None">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="8" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="nyaa:NyaaDownloadTaskSnapshot">
                            <Grid RowDefinitions="Auto,Auto,Auto"
                                  ColumnDefinitions="*,Auto"
                                  ColumnSpacing="12"
                                  RowSpacing="6"
                                  Padding="4,6">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{x:Bind Item.Title}"
                                               TextTrimming="CharacterEllipsis"
                                               Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="{x:Bind Status, Mode=OneWay}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind Error, Mode=OneWay}"
                                               Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                               TextWrapping="Wrap"
                                               Visibility="{x:Bind HasError, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />
                                </StackPanel>

                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            Spacing="6">
                                    <Button x:Uid="NyaaPauseButton"
                                            Content="Pause"
                                            Command="{Binding ViewModel.PauseDownloadCommand, ElementName=RootDialog}"
                                            CommandParameter="{x:Bind}"
                                            Visibility="{x:Bind CanPause, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />
                                    <Button x:Uid="NyaaResumeButton"
                                            Content="Resume"
                                            Command="{Binding ViewModel.ResumeDownloadCommand, ElementName=RootDialog}"
                                            CommandParameter="{x:Bind}"
                                            Visibility="{x:Bind CanResume, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />
                                    <Button x:Uid="NyaaCancelButton"
                                            Content="Cancel"
                                            Command="{Binding ViewModel.CancelDownloadCommand, ElementName=RootDialog}"
                                            CommandParameter="{x:Bind}"
                                            Visibility="{x:Bind CanCancel, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />
                                    <Button x:Uid="NyaaRetryButton"
                                            Content="Retry"
                                            Command="{Binding ViewModel.RetryDownloadCommand, ElementName=RootDialog}"
                                            CommandParameter="{x:Bind}"
                                            Visibility="{x:Bind CanRetry, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />
                                    <Button x:Uid="NyaaOpenFolderButton"
                                            Content="Open folder"
                                            Command="{Binding ViewModel.OpenDownloadFolderCommand, ElementName=RootDialog}"
                                            CommandParameter="{x:Bind}"
                                            Visibility="{x:Bind CanOpenFolder, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />
                                    <Button x:Uid="NyaaRemoveTaskButton"
                                            Content="Remove"
                                            Command="{Binding ViewModel.RemoveDownloadCommand, ElementName=RootDialog}"
                                            CommandParameter="{x:Bind}"
                                            Visibility="{x:Bind CanRemove, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />
                                </StackPanel>

                                <ProgressBar Grid.Row="1"
                                             Grid.ColumnSpan="2"
                                             Minimum="0"
                                             Maximum="100"
                                             Value="{x:Bind ProgressPercent, Mode=OneWay}" />
                                <TextBlock Grid.Row="2"
                                           Grid.ColumnSpan="2"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                    <Run Text="{x:Bind ProgressText, Mode=OneWay}" />
                                    <Run Text=" · " />
                                    <Run Text="{x:Bind DownloadRateText, Mode=OneWay}" />
                                    <Run Text=" · " />
                                    <Run Text="{x:Bind ConnectedPeers, Mode=OneWay}" />
                                    <Run x:Uid="NyaaPeersRun" Text=" peers" />
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock x:Uid="NyaaNoDownloadsText"
                           Grid.Row="1"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="No download tasks yet."
                           Visibility="{x:Bind ViewModel.NoDownloads, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />
            </Grid>
        </TabViewItem>
    </TabView>
</ContentDialog>
