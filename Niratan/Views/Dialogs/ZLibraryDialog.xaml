<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog x:Class="Niratan.Views.Dialogs.ZLibraryDialog"
               x:Name="RootDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
               xmlns:converters="using:Niratan.Helpers.UI.Converters"
               xmlns:components="using:Niratan.ViewModels.Components"
               mc:Ignorable="d"
                x:Uid="ZLibraryDialog"
                Title="Z-Library"
                CloseButtonText="Close"
                DefaultButton="Close">
    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMinWidth">1080</x:Double>
        <x:Double x:Key="ContentDialogMaxWidth">1180</x:Double>
        <x:Double x:Key="ContentDialogMinHeight">760</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">800</x:Double>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:BooleanNegationConverter x:Key="BooleanNegationConverter" />
    </ContentDialog.Resources>

    <ScrollViewer Width="1080"
                  Height="650"
                  VerticalScrollBarVisibility="Auto">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*"
              RowSpacing="14">
            <Expander x:Uid="ZLibraryAccountExpander"
                      Header="Account and server"
                      IsExpanded="{x:Bind ViewModel.IsConnected, Converter={StaticResource BooleanNegationConverter}, Mode=OneWay}">
                <StackPanel Spacing="10">
                    <TextBlock x:Uid="ZLibraryCredentialHint"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="Use the HTTPS server address shown on your Z-Access page. Credentials are stored in Windows Credential Manager."
                               TextWrapping="Wrap" />
                    <TextBox x:Uid="ZLibraryBaseUrlBox"
                             Header="Server address"
                             PlaceholderText="https://your-current-z-library-server.example"
                             AutomationProperties.AutomationId="ZLibraryBaseUrlBox"
                             Text="{x:Bind ViewModel.BaseUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{x:Bind ViewModel.CanChangeConnection, Mode=OneWay}" />
                    <Grid ColumnDefinitions="*,*"
                          ColumnSpacing="12">
                        <TextBox x:Uid="ZLibraryEmailBox"
                                 Header="Email"
                                 AutomationProperties.AutomationId="ZLibraryEmailBox"
                                 Text="{x:Bind ViewModel.Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{x:Bind ViewModel.CanChangeConnection, Mode=OneWay}" />
                        <PasswordBox x:Name="PasswordBox"
                                     x:Uid="ZLibraryPasswordBox"
                                     Grid.Column="1"
                                     Header="Password"
                                     AutomationProperties.AutomationId="ZLibraryPasswordBox"
                                     PasswordChanged="PasswordBox_PasswordChanged"
                                     IsEnabled="{x:Bind ViewModel.CanChangeConnection, Mode=OneWay}" />
                    </Grid>
                    <StackPanel Orientation="Horizontal"
                                Spacing="10">
                        <Button x:Uid="ZLibraryConnectButton"
                                Content="Connect and save"
                                Style="{StaticResource AccentButtonStyle}"
                                AutomationProperties.AutomationId="ZLibraryConnectButton"
                                Command="{x:Bind ViewModel.ConnectCommand}"
                                IsEnabled="{x:Bind ViewModel.CanChangeConnection, Mode=OneWay}" />
                        <Button x:Uid="ZLibraryDisconnectButton"
                                Content="Forget account"
                                AutomationProperties.AutomationId="ZLibraryDisconnectButton"
                                Command="{x:Bind ViewModel.DisconnectCommand}"
                                IsEnabled="{x:Bind ViewModel.CanChangeConnection, Mode=OneWay}" />
                        <TextBlock VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="{x:Bind ViewModel.ConnectionStatus, Mode=OneWay}" />
                    </StackPanel>
                </StackPanel>
            </Expander>

            <InfoBar Grid.Row="1"
                     Severity="Error"
                     IsClosable="False"
                     IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                     Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />

            <Grid Grid.Row="2"
                  ColumnDefinitions="*,Auto"
                  ColumnSpacing="10">
                <TextBox x:Name="SearchBox"
                         x:Uid="ZLibrarySearchBox"
                         PlaceholderText="Search title, author, ISBN, or keyword"
                         AutomationProperties.AutomationId="ZLibrarySearchBox"
                         Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{x:Bind ViewModel.CanSearch, Mode=OneWay}"
                         KeyDown="SearchBox_KeyDown" />
                <Button Grid.Column="1"
                        x:Uid="ZLibrarySearchButton"
                        Content="Search"
                        Style="{StaticResource AccentButtonStyle}"
                        AutomationProperties.AutomationId="ZLibrarySearchButton"
                        Command="{x:Bind ViewModel.SearchCommand}"
                        IsEnabled="{x:Bind ViewModel.CanSearch, Mode=OneWay}" />
            </Grid>

            <Grid Grid.Row="3"
                  RowDefinitions="Auto,Auto"
                  RowSpacing="8">
                <StackPanel Orientation="Horizontal"
                            Spacing="18">
                    <CheckBox x:Uid="ZLibraryExactMatchingCheckBox"
                              Content="Exact matching"
                              VerticalAlignment="Center"
                              IsChecked="{x:Bind ViewModel.ExactMatching, Mode=TwoWay}" />
                </StackPanel>

                <StackPanel Grid.Row="1"
                            Orientation="Horizontal"
                            Spacing="10">
                    <ComboBox x:Uid="ZLibraryYearFromComboBox"
                              Width="130"
                              Header="Year from"
                              DisplayMemberPath="Label"
                              ItemsSource="{x:Bind ViewModel.YearOptions, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.SelectedYearFrom, Mode=TwoWay}" />
                    <ComboBox x:Uid="ZLibraryYearToComboBox"
                              Width="130"
                              Header="Year to"
                              DisplayMemberPath="Label"
                              ItemsSource="{x:Bind ViewModel.YearOptions, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.SelectedYearTo, Mode=TwoWay}" />
                    <ComboBox x:Uid="ZLibraryLanguageComboBox"
                              Width="170"
                              Header="Language"
                              DisplayMemberPath="Label"
                              ItemsSource="{x:Bind ViewModel.LanguageOptions, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.SelectedLanguage, Mode=TwoWay}" />
                    <ComboBox x:Uid="ZLibraryExtensionComboBox"
                              Width="145"
                              Header="Format"
                              DisplayMemberPath="Label"
                              ItemsSource="{x:Bind ViewModel.ExtensionOptions, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.SelectedExtension, Mode=TwoWay}" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="4"
                  ColumnDefinitions="Auto,*,Auto,Auto"
                  ColumnSpacing="8">
                <ProgressRing Width="20"
                              Height="20"
                              IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                              Visibility="{x:Bind ViewModel.IsBusy, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />
                <TextBlock Grid.Column="1"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="{x:Bind ViewModel.ResultSummary, Mode=OneWay}" />
                <Button Grid.Column="2"
                        x:Uid="ZLibraryPreviousButton"
                        Content="Previous"
                        Command="{x:Bind ViewModel.PreviousPageCommand}"
                        IsEnabled="{x:Bind ViewModel.CanGoPrevious, Mode=OneWay}" />
                <Button Grid.Column="3"
                        x:Uid="ZLibraryNextButton"
                        Content="Next"
                        Command="{x:Bind ViewModel.NextPageCommand}"
                        IsEnabled="{x:Bind ViewModel.CanGoNext, Mode=OneWay}" />
            </Grid>

            <ListView Grid.Row="5"
                      MinHeight="280"
                      MaxHeight="430"
                      AutomationProperties.AutomationId="ZLibraryResultsList"
                      ItemsSource="{x:Bind ViewModel.Results, Mode=OneWay}"
                      SelectionMode="None">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="8" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="components:ZLibraryBookItemViewModel">
                        <Grid ColumnDefinitions="*,Auto"
                              ColumnSpacing="16"
                              Padding="4,6">
                            <StackPanel Spacing="3">
                                <TextBlock Text="{x:Bind Title}"
                                           Style="{StaticResource BodyStrongTextBlockStyle}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind Author}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind Metadata}"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1"
                                        MinWidth="116"
                                        HorizontalAlignment="Right"
                                        Spacing="4">
                                <Button x:Uid="ZLibraryDownloadButton"
                                        Content="Add to shelf"
                                        HorizontalAlignment="Stretch"
                                        Command="{Binding ViewModel.DownloadBookCommand, ElementName=RootDialog}"
                                        CommandParameter="{x:Bind}"
                                        IsEnabled="{x:Bind CanDownload, Mode=OneWay}" />
                                <TextBlock HorizontalAlignment="Center"
                                           FontSize="12"
                                           Text="{x:Bind Status, Mode=OneWay}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </ScrollViewer>
</ContentDialog>
