<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="Niratan.Views.Pages.VideoDiscoveryResourceSearchPage"
      x:Name="ThisPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:components="using:Niratan.ViewModels.Components"
      xmlns:converters="using:Niratan.Helpers.UI.Converters">
    <Page.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Page.Resources>

    <Grid Padding="20,12,24,24" RowDefinitions="Auto,Auto,*,Auto">
        <CommandBar Grid.Row="0" DefaultLabelPosition="Right">
            <CommandBar.Content>
                <TextBlock Text="{x:Bind ViewModel.PageTitle, Mode=OneWay}"
                           Style="{StaticResource TitleTextBlockStyle}" />
            </CommandBar.Content>
            <AppBarButton x:Uid="VideoDiscoveryResourceBackButton"
                          AutomationProperties.AutomationId="VideoDiscoveryResourceBackButton"
                          Label="Back"
                          Click="BackButton_Click">
                <AppBarButton.Icon><SymbolIcon Symbol="Back" /></AppBarButton.Icon>
            </AppBarButton>
        </CommandBar>

        <Grid Grid.Row="1"
              Margin="0,12,0,12"
              ColumnDefinitions="*,170,Auto"
              ColumnSpacing="8">
            <TextBox x:Name="ResourceSearchBox"
                     x:Uid="DiscoverResourceQueryBox"
                     AutomationProperties.AutomationId="VideoDiscoveryResourceQueryBox"
                     Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     KeyDown="ResourceSearchBox_KeyDown" />
            <ComboBox Grid.Column="1"
                      x:Uid="DiscoverResourceCategoryBox"
                      DisplayMemberPath="DisplayName"
                      ItemsSource="{x:Bind ViewModel.Categories, Mode=OneWay}"
                      SelectedItem="{x:Bind ViewModel.SelectedCategory, Mode=TwoWay}" />
            <Button Grid.Column="2"
                    x:Uid="DiscoverSearchNyaaButton"
                    AutomationProperties.AutomationId="VideoDiscoveryResourceSearchButton"
                    Command="{x:Bind ViewModel.SearchCommand}"
                    Content="Search Nyaa"
                    Style="{StaticResource AccentButtonStyle}" />
        </Grid>

        <Grid Grid.Row="2">
            <ListView AutomationProperties.AutomationId="VideoDiscoveryResourceResults"
                      ItemsSource="{x:Bind ViewModel.Results, Mode=OneWay}"
                      SelectedItem="{x:Bind ViewModel.SelectedResult, Mode=TwoWay}"
                      SelectionMode="Single"
                      IsItemClickEnabled="False">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="components:NyaaTorrentItemViewModel">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="6,10">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{x:Bind Title}"
                                           Style="{StaticResource BodyStrongTextBlockStyle}"
                                           TextAlignment="Left"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{x:Bind Metadata}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextAlignment="Left"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{x:Bind Status, Mode=OneWay}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextAlignment="Left"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       Text="{x:Bind TrustLabel}"
                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <ProgressRing Width="30"
                          Height="30"
                          IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
        </Grid>

        <StackPanel Grid.Row="3" Spacing="10">
            <Border Padding="14"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8"
                    Visibility="{x:Bind ViewModel.IsSubscriptionMode, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="16">
                    <StackPanel>
                        <TextBlock x:Uid="VideoDiscoverySubscriptionReleaseGroupLabel"
                                   Text="Release group"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.StrictReleaseGroup, Mode=OneWay}"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock x:Uid="VideoDiscoverySubscriptionResolutionLabel"
                                   Text="Resolution"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.StrictResolution, Mode=OneWay}"
                                   FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock x:Uid="VideoDiscoverySubscriptionStartFromLabel"
                                   Text="Start from episode"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.StrictStartAfterText, Mode=OneWay}"
                                   FontWeight="SemiBold" />
                    </StackPanel>
                </Grid>
            </Border>
            <InfoBar IsClosable="False"
                     IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                     Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                     Severity="Warning" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center" />
                <Button Grid.Column="1"
                        AutomationProperties.AutomationId="VideoDiscoveryResourceSubmitButton"
                        Command="{x:Bind ViewModel.SubmitSelectionCommand}"
                        Content="{x:Bind ViewModel.DownloadActionText, Mode=OneWay}"
                        Style="{StaticResource AccentButtonStyle}" />
            </Grid>
        </StackPanel>
    </Grid>
</Page>
