<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="Niratan.Views.Pages.VideoDiscoverySubtitleSearchPage"
      x:Name="ThisPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:components="using:Niratan.ViewModels.Components"
      xmlns:converters="using:Niratan.Helpers.UI.Converters">
    <Page.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Page.Resources>

    <Grid Padding="20,12,24,24" RowDefinitions="Auto,Auto,Auto,*,Auto">
        <CommandBar Grid.Row="0" DefaultLabelPosition="Right">
            <CommandBar.Content>
                <TextBlock x:Uid="VideoDiscoverySubtitlePageTitleText"
                           Text="Search Jimaku subtitles"
                           Style="{StaticResource TitleTextBlockStyle}" />
            </CommandBar.Content>
            <AppBarButton x:Uid="VideoDiscoverySubtitleBackButton"
                          AutomationProperties.AutomationId="VideoDiscoverySubtitleBackButton"
                          Label="Back"
                          Click="BackButton_Click">
                <AppBarButton.Icon><SymbolIcon Symbol="Back" /></AppBarButton.Icon>
            </AppBarButton>
        </CommandBar>

        <Grid Grid.Row="1"
              Margin="0,12,0,12"
              ColumnDefinitions="*,Auto"
              ColumnSpacing="8">
            <TextBox x:Name="SubtitleSearchBox"
                     x:Uid="VideoDiscoverySubtitleQueryBox"
                     AutomationProperties.AutomationId="VideoDiscoverySubtitleQueryBox"
                     Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     KeyDown="SubtitleSearchBox_KeyDown" />
            <Button Grid.Column="1"
                    x:Uid="VideoDiscoverySubtitleSearchButton"
                    AutomationProperties.AutomationId="VideoDiscoverySubtitleSearchButton"
                    Command="{x:Bind ViewModel.SearchCommand}"
                    Content="Search subtitles"
                    Style="{StaticResource AccentButtonStyle}" />
        </Grid>

        <Grid Grid.Row="2"
              Margin="0,0,0,12"
              ColumnDefinitions="260,*,Auto"
              ColumnSpacing="10">
            <ComboBox x:Uid="VideoDiscoverySubtitleDestinationBox"
                      AutomationProperties.AutomationId="VideoDiscoverySubtitleDestinationBox"
                      Header="Save destination"
                      DisplayMemberPath="DisplayName"
                      ItemsSource="{x:Bind ViewModel.Destinations, Mode=OneWay}"
                      SelectedItem="{x:Bind ViewModel.SelectedDestination, Mode=TwoWay}" />
            <TextBlock Grid.Column="1"
                       Text="{x:Bind ViewModel.TargetPathText, Mode=OneWay}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Bottom"
                       Margin="0,0,0,8" />
            <Button Grid.Column="2"
                    x:Uid="VideoDiscoverySubtitlePickTargetButton"
                    AutomationProperties.AutomationId="VideoDiscoverySubtitlePickTargetButton"
                    Command="{x:Bind ViewModel.PickTargetCommand}"
                    Content="Choose…"
                    VerticalAlignment="Bottom"
                    Visibility="{x:Bind ViewModel.NeedsTargetPicker, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />
        </Grid>

        <Grid Grid.Row="3">
            <ListView AutomationProperties.AutomationId="VideoDiscoverySubtitleResults"
                      ItemsSource="{x:Bind ViewModel.Results, Mode=OneWay}"
                      SelectedItem="{x:Bind ViewModel.SelectedResult, Mode=TwoWay}"
                      SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="components:JimakuSubtitleItemViewModel">
                        <StackPanel Padding="6,10" Spacing="4">
                            <TextBlock Text="{x:Bind Title}"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"
                                       TextAlignment="Left"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind Metadata}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextAlignment="Left"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind Status, Mode=OneWay}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextAlignment="Left"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <ProgressRing Width="30"
                          Height="30"
                          IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
        </Grid>

        <StackPanel Grid.Row="4" Spacing="10">
            <InfoBar IsClosable="False"
                     IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                     Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                     Severity="Warning" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center" />
                <Button Grid.Column="1"
                        x:Uid="VideoDiscoverySubtitleSaveButton"
                        AutomationProperties.AutomationId="VideoDiscoverySubtitleSaveButton"
                        Command="{x:Bind ViewModel.SaveSelectedCommand}"
                        Content="Save"
                        Style="{StaticResource AccentButtonStyle}" />
            </Grid>
        </StackPanel>
    </Grid>
</Page>
