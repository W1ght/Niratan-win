<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="Niratan.Views.Pages.BrowsePage"
      x:Name="ThisPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:components="using:Niratan.ViewModels.Components"
      xmlns:controls="using:Niratan.Views.Controls"
      xmlns:converters="using:Niratan.Helpers.UI.Converters"
      xmlns:manga="using:Niratan.Views.Manga">
    <Page.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <CollectionViewSource x:Key="GroupedBrowseSources"
                              IsSourceGrouped="True"
                              Source="{Binding BrowseSourceGroups}" />

        <DataTemplate x:Key="RemoteMangaBookTemplate"
                      x:DataType="components:RemoteMangaLibraryItemViewModel">
            <controls:NovelBookCard AutomationId="{x:Bind AutomationId, Mode=OneTime}"
                                    Title="{x:Bind Title, Mode=OneTime}"
                                    CoverImage="{x:Bind CoverImage, Mode=OneWay}"
                                    HasCover="{x:Bind HasCover, Mode=OneWay}"
                                    ShowsProgress="False"
                                    PlaceholderGlyph="&#xE8B9;"
                                    Command="{x:Bind OpenCommand}" />
        </DataTemplate>

        <DataTemplate x:Key="MangaDiscoveryCardTemplate"
                      x:DataType="components:MangaDiscoveryCardViewModel">
            <Button Width="170"
                    Height="350"
                    Padding="0"
                    HorizontalAlignment="Left"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Top"
                    AutomationProperties.AutomationId="{x:Bind AutomationId, Mode=OneTime}"
                    Background="Transparent"
                    BorderThickness="0"
                    Command="{x:Bind OpenCommand}">
                <StackPanel Width="170"
                            Spacing="5">
                    <Grid Height="238"
                          Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <FontIcon FontSize="42"
                                  Glyph="&#xE8B4;"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <Image Source="{x:Bind PosterImage, Mode=OneWay}"
                               Stretch="UniformToFill"
                               Visibility="{x:Bind HasPoster, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />
                    </Grid>
                    <TextBlock Height="48"
                               MaxLines="2"
                               Style="{StaticResource BodyStrongTextBlockStyle}"
                               Text="{x:Bind Title, Mode=OneTime}"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="Wrap" />
                    <TextBlock Height="24"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="{x:Bind FactsText, Mode=OneTime}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Height="24"
                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                               Text="{x:Bind SourceText, Mode=OneTime}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="MangaDiscoverSectionTemplate"
                      x:DataType="components:MangaDiscoverSectionViewModel">
            <StackPanel Spacing="8">
                <TextBlock Text="{x:Bind Title, Mode=OneTime}"
                           Style="{StaticResource SubtitleTextBlockStyle}" />
                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled"
                              Loaded="HorizontalMangaList_Loaded"
                              Unloaded="HorizontalMangaList_Unloaded">
                    <ItemsRepeater ElementPrepared="MangaDiscoveryCard_ElementPrepared"
                                   ItemTemplate="{StaticResource MangaDiscoveryCardTemplate}"
                                   ItemsSource="{x:Bind Items, Mode=OneTime}">
                        <ItemsRepeater.Layout>
                            <StackLayout Orientation="Horizontal"
                                         Spacing="14" />
                        </ItemsRepeater.Layout>
                    </ItemsRepeater>
                </ScrollViewer>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="BrowseSourceTemplate"
                      x:DataType="components:MangaBrowseSourceItemViewModel">
            <Grid MinHeight="64"
                  Padding="12,6"
                  ColumnDefinitions="Auto,*,Auto,Auto"
                  ColumnSpacing="14"
                  Loaded="BrowseSourceRow_Loaded">
                <Border Width="44"
                        Height="44"
                        VerticalAlignment="Center"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="6">
                    <Grid>
                        <Image Margin="4"
                               ImageFailed="BrowseSourceIcon_ImageFailed"
                               Source="{x:Bind IconImage, Mode=OneWay}"
                               Stretch="Uniform"
                               Visibility="{x:Bind HasIcon, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />
                        <FontIcon FontSize="22"
                                  Glyph="&#xE74C;"
                                  Visibility="{x:Bind NeedsIconFallback, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="2">
                    <TextBlock FontSize="16"
                               Text="{x:Bind Name, Mode=OneTime}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="{x:Bind Metadata, Mode=OneTime}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button x:Uid="BrowseSourcePopularButton"
                        Grid.Column="2"
                        Margin="12,0,4,0"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="BrowseSourcePopularButton"
                        Background="Transparent"
                        BorderThickness="0"
                        Command="{x:Bind OpenCommand}"
                        Content="Popular"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <Button Grid.Column="3"
                        Width="42"
                        Height="42"
                        Padding="0"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="{x:Bind RemoveAutomationId, Mode=OneTime}"
                        Command="{x:Bind RemoveCommand}"
                        ToolTipService.ToolTip="{x:Bind RemoveActionLabel, Mode=OneTime}"
                        Visibility="{x:Bind CanRemove, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneTime}">
                    <SymbolIcon Symbol="Delete" />
                </Button>
            </Grid>
        </DataTemplate>

    </Page.Resources>

    <Grid Padding="0">
        <Grid RowDefinitions="Auto,*"
              Visibility="{x:Bind ViewModel.IsDiscoverSectionSelected, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
            <StackPanel x:Name="MangaDiscoverSearchToolbar"
                        Grid.Row="0"
                        Margin="20,16,36,0"
                        Spacing="10">
                <Grid ColumnDefinitions="*,Auto"
                      ColumnSpacing="8">
                    <TextBox x:Name="MangaDiscoverSearchBox"
                             x:Uid="MangaDiscoverSearchTextBox"
                             AutomationProperties.AutomationId="MangaDiscoverSearchTextBox"
                             KeyDown="MangaDiscoverSearchTextBox_KeyDown"
                             PlaceholderText="Search manga"
                             Text="{x:Bind ViewModel.MangaDiscoverQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Grid.Column="1"
                            x:Uid="MangaDiscoverSearchButton"
                            AutomationProperties.AutomationId="MangaDiscoverSearchButton"
                            Command="{x:Bind ViewModel.SearchMangaDiscoverCommand}"
                            Content="Search"
                            Style="{StaticResource AccentButtonStyle}" />
                </Grid>

                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal"
                                Spacing="8">
                        <ComboBox x:Uid="MangaDiscoverProviderBox"
                                  Width="150"
                                  AutomationProperties.AutomationId="MangaDiscoverProviderBox"
                                  DisplayMemberPath="DisplayName"
                                  Header="Metadata source"
                                  ItemsSource="{x:Bind ViewModel.MangaDiscoveryProviders, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.SelectedMangaDiscoveryProvider, Mode=TwoWay}" />
                        <ComboBox x:Uid="MangaDiscoverFeedBox"
                                  Width="190"
                                  AutomationProperties.AutomationId="MangaDiscoverFeedBox"
                                  DisplayMemberPath="DisplayName"
                                  Header="Category"
                                  ItemsSource="{x:Bind ViewModel.MangaDiscoveryFeeds, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.SelectedMangaDiscoveryFeed, Mode=TwoWay}" />
                        <Button x:Uid="MangaDiscoverRefreshButton"
                                VerticalAlignment="Bottom"
                                AutomationProperties.AutomationId="MangaDiscoverRefreshButton"
                                Command="{x:Bind ViewModel.RefreshMangaDiscoverCommand}"
                                Content="Refresh" />
                    </StackPanel>
                </ScrollViewer>
            </StackPanel>

            <ScrollViewer x:Name="MangaDiscoverContentScrollViewer"
                          Grid.Row="1"
                          Margin="20,12,36,24"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          ViewChanged="MangaDiscoverContentScrollViewer_ViewChanged">
                <StackPanel Spacing="14">
                    <TextBlock Text="{x:Bind ViewModel.MangaDiscoverStatusMessage, Mode=OneWay}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                    <StackPanel Spacing="10"
                                Visibility="{x:Bind ViewModel.IsMangaDiscoverSearchMode, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert, Mode=OneWay}">
                        <ItemsRepeater AutomationProperties.AutomationId="MangaDiscoverSections"
                                       ItemTemplate="{StaticResource MangaDiscoverSectionTemplate}"
                                       ItemsSource="{x:Bind ViewModel.MangaDiscoverSections, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="22" />
                            </ItemsRepeater.Layout>
                        </ItemsRepeater>
                    </StackPanel>
                    <TextBlock x:Uid="MangaDiscoverSearchResultsHeading"
                               AutomationProperties.AutomationId="MangaDiscoverSearchResultsHeading"
                               Style="{StaticResource SubtitleTextBlockStyle}"
                               Text="Search results"
                               Visibility="{x:Bind ViewModel.IsMangaDiscoverSearchMode, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />
                    <ItemsRepeater AutomationProperties.AutomationId="MangaDiscoverSearchResults"
                                   ElementPrepared="MangaDiscoveryCard_ElementPrepared"
                                   ItemTemplate="{StaticResource MangaDiscoveryCardTemplate}"
                                   ItemsSource="{x:Bind ViewModel.MangaDiscoverItems, Mode=OneWay}"
                                   Visibility="{x:Bind ViewModel.IsMangaDiscoverSearchMode, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout MinItemWidth="180"
                                                MinItemHeight="350"
                                                MinRowSpacing="18"
                                                MinColumnSpacing="14" />
                        </ItemsRepeater.Layout>
                    </ItemsRepeater>
                    <ProgressRing Width="28"
                                  Height="28"
                                  HorizontalAlignment="Center"
                                  IsActive="{x:Bind ViewModel.IsMangaDiscoverLoadingMore, Mode=OneWay}"
                                  Visibility="{x:Bind ViewModel.IsMangaDiscoverLoadingMore, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />
                    <ProgressRing Width="28"
                                  Height="28"
                                  HorizontalAlignment="Left"
                                  IsActive="{x:Bind ViewModel.IsMangaDiscoverLoading, Mode=OneWay}"
                                  Visibility="{x:Bind ViewModel.IsMangaDiscoverLoading, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />
                    <StackPanel HorizontalAlignment="Center"
                                MaxWidth="520"
                                Spacing="8"
                                Visibility="{x:Bind ViewModel.ShowMangaDiscoverPlaceholder, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
                        <FontIcon FontSize="46"
                                  HorizontalAlignment="Center"
                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                  Glyph="&#xE8B4;" />
                        <TextBlock x:Uid="MangaDiscoverEmptyText"
                                   HorizontalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="Choose a metadata source to discover manga."
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Grid
              Visibility="{x:Bind ViewModel.IsBrowseSourceDirectoryVisible, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
            <ListView AutomationProperties.AutomationId="BrowseSourcesList"
                      ItemTemplate="{StaticResource BrowseSourceTemplate}"
                      ItemsSource="{Binding Source={StaticResource GroupedBrowseSources}}"
                      SelectionMode="None"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollMode="Enabled">
                <ListView.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate x:DataType="components:MangaBrowseSourceGroupViewModel">
                                <TextBlock Margin="20,14,36,4"
                                           FontWeight="SemiBold"
                                           Text="{x:Bind Label, Mode=OneTime}" />
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListView.GroupStyle>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="CornerRadius" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="Padding" Value="0" />
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>

            <StackPanel MaxWidth="520"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="12"
                        Visibility="{x:Bind ViewModel.HasNoBrowseSources, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
                <FontIcon HorizontalAlignment="Center"
                          FontSize="46"
                          Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                          Glyph="&#xE74C;" />
                <TextBlock x:Uid="MangaBrowseEmptyText"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="No sources installed. Open manga extensions to install or configure one."
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
                <Button x:Uid="BrowseShowExtensionsButton"
                        HorizontalAlignment="Center"
                        AutomationProperties.AutomationId="BrowseShowExtensionsButton"
                        Command="{x:Bind ViewModel.SelectSourcesCommand}"
                        Content="Show extensions" />
            </StackPanel>
        </Grid>

        <Grid
              RowDefinitions="Auto,*"
              Visibility="{x:Bind ViewModel.IsBrowseResultsVisible, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
            <Grid Margin="16,10,36,12"
                  ColumnDefinitions="Auto,220,*,Auto,Auto"
                  ColumnSpacing="8">
                <Button x:Uid="BrowseResultsBackButton"
                        Width="40"
                        Height="40"
                        Padding="0"
                        AutomationProperties.AutomationId="BrowseResultsBackButton"
                        Command="{x:Bind ViewModel.CloseBrowseResultsCommand}"
                        ToolTipService.ToolTip="Back to sources">
                    <SymbolIcon Symbol="Back" />
                </Button>
                <TextBlock Grid.Column="1"
                           VerticalAlignment="Center"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Text="{x:Bind ViewModel.BrowseResultsTitle, Mode=OneWay}"
                           TextTrimming="CharacterEllipsis" />
                <TextBox x:Uid="BrowseResultsSearchTextBox"
                         Grid.Column="2"
                         AutomationProperties.AutomationId="MangaBrowseSearchTextBox"
                         PlaceholderText="Search this source"
                         Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Button x:Uid="MangaBrowsePopularButton"
                        Grid.Column="3"
                        AutomationProperties.AutomationId="MangaBrowsePopularButton"
                        Command="{x:Bind ViewModel.BrowsePopularCommand}"
                        Content="Popular" />
                <Button x:Uid="MangaBrowseSearchButton"
                        Grid.Column="4"
                        AutomationProperties.AutomationId="MangaBrowseSearchButton"
                        Command="{x:Bind ViewModel.SearchMangaSourceCommand}"
                        Content="Search"
                        Style="{StaticResource AccentButtonStyle}" />
            </Grid>

            <Grid Grid.Row="1">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Margin="20,0,36,10"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="{x:Bind ViewModel.SuwayomiStatusMessage, Mode=OneWay}"
                                   TextWrapping="Wrap"
                                   Visibility="{x:Bind ViewModel.IsSuwayomiSourceKind, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />
                        <TextBlock Margin="20,0,36,10"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="{x:Bind ViewModel.MihonStatusMessage, Mode=OneWay}"
                                   TextWrapping="Wrap"
                                   Visibility="{x:Bind ViewModel.IsMihonSourceKind, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />
                        <ItemsRepeater Margin="20,0,36,24"
                                       AutomationProperties.AutomationId="MangaBrowseBookshelf"
                                       ElementPrepared="MangaBrowseBookshelf_ElementPrepared"
                                       ItemTemplate="{StaticResource RemoteMangaBookTemplate}"
                                       ItemsSource="{x:Bind ViewModel.BrowseBooks, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout MinItemWidth="180"
                                                   MinItemHeight="326"
                                                   MinColumnSpacing="12"
                                                   MinRowSpacing="16"
                                                   ItemsJustification="Start" />
                            </ItemsRepeater.Layout>
                        </ItemsRepeater>
                        <ProgressRing Width="28"
                                      Height="28"
                                      Margin="0,0,0,24"
                                      HorizontalAlignment="Center"
                                      IsActive="{x:Bind ViewModel.IsBrowseLoadingMore, Mode=OneWay}"
                                      Visibility="{x:Bind ViewModel.IsBrowseLoadingMore, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />
                    </StackPanel>
                </ScrollViewer>
                <ProgressRing Width="60"
                              Height="60"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              IsActive="{x:Bind ViewModel.IsSuwayomiBusy, Mode=OneWay}"
                              Visibility="{x:Bind ViewModel.IsSuwayomiBusy, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />
                <ProgressRing Width="60"
                              Height="60"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              IsActive="{x:Bind ViewModel.IsMihonBusy, Mode=OneWay}"
                              Visibility="{x:Bind ViewModel.IsMihonBusy, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />
            </Grid>
        </Grid>

        <manga:MihonExtensionBrowser
                                     ViewModel="{x:Bind ViewModel, Mode=OneWay}"
                                     Visibility="{x:Bind ViewModel.IsSourcesSectionSelected, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />

        <manga:MangaSourceSettingsContent
                                           ViewModel="{x:Bind ViewModel, Mode=OneWay}"
                                           Visibility="{x:Bind ViewModel.IsSettingsSectionSelected, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />

        <manga:RemoteMangaDetailView
                                     ViewModel="{x:Bind ViewModel, Mode=OneWay}" />
    </Grid>
</Page>
