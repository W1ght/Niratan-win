<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="Niratan.Views.Pages.MangaLibraryPage"
      x:Name="ThisPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:components="using:Niratan.ViewModels.Components"
      xmlns:controls="using:Niratan.Views.Controls"
      xmlns:converters="using:Niratan.Helpers.UI.Converters"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:manga="using:Niratan.Views.Manga"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      AllowDrop="True"
      DragOver="MangaLibrary_DragOver"
      Drop="MangaLibrary_Drop"
      mc:Ignorable="d">
    <Page.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <DataTemplate x:Key="MangaBookTemplate"
                      x:DataType="components:MangaLibraryItemViewModel">
            <controls:NovelBookCard AutomationId="{x:Bind AutomationId, Mode=OneTime}"
                                    Title="{x:Bind Title, Mode=OneTime}"
                                    CoverImage="{x:Bind CoverImage, Mode=OneTime}"
                                    HasCover="{x:Bind HasCover, Mode=OneTime}"
                                    OverallProgressPercent="{x:Bind ProgressPercent, Mode=OneWay}"
                                    OverallProgressText="{x:Bind ProgressText, Mode=OneWay}"
                                    PlaceholderGlyph="&#xE8B9;"
                                    Command="{x:Bind OpenCommand}">
                <controls:NovelBookCard.CardContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem x:Uid="MangaLibraryOpenMenuItem"
                                        Text="Open"
                                        Command="{x:Bind OpenCommand}" />
                        <MenuFlyoutItem x:Uid="MangaLibraryRenameMenuItem"
                                        Text="Rename"
                                        Command="{x:Bind RenameCommand}" />
                        <MenuFlyoutItem x:Uid="MangaLibraryMarkReadMenuItem"
                                        Text="Mark as read"
                                        Command="{x:Bind MarkReadCommand}" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Uid="MangaLibraryRemoveMenuItem"
                                        Text="Remove from library"
                                        Command="{x:Bind RemoveCommand}" />
                    </MenuFlyout>
                </controls:NovelBookCard.CardContextFlyout>
            </controls:NovelBookCard>
        </DataTemplate>

        <DataTemplate x:Key="RemoteMangaBookTemplate"
                      x:DataType="components:RemoteMangaLibraryItemViewModel">
            <controls:NovelBookCard AutomationId="{x:Bind AutomationId, Mode=OneTime}"
                                    Title="{x:Bind Title, Mode=OneTime}"
                                    CoverImage="{x:Bind CoverImage, Mode=OneWay}"
                                    HasCover="{x:Bind HasCover, Mode=OneWay}"
                                    ShowsProgress="False"
                                    PlaceholderGlyph="&#xE8B9;"
                                    Command="{x:Bind OpenCommand}" />
        </DataTemplate>

        <Style x:Key="MangaLibrarySurfaceButtonStyle"
               TargetType="ToggleButton">
            <Setter Property="MinWidth" Value="76" />
            <Setter Property="Padding" Value="14,5" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
    </Page.Resources>

    <Grid Padding="0,32,0,0"
          RowDefinitions="Auto,*">
        <CommandBar Grid.Row="0"
                    Margin="12,6,28,10"
                    AutomationProperties.AutomationId="MangaLibraryCommandBar"
                    DefaultLabelPosition="Right">
            <CommandBar.Content>
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Spacing="22">
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <FontIcon FontSize="24"
                                  Glyph="&#xE8B9;" />
                            <TextBlock x:Uid="MangaLibraryTitleText"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource TitleTextBlockStyle}"
                                   Text="Manga" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal"
                                Spacing="4">
                        <ToggleButton x:Uid="MangaLibraryLocalSurfaceButton"
                                      AutomationProperties.AutomationId="MangaLibraryLocalSurfaceButton"
                                      Command="{x:Bind ViewModel.SelectLocalCommand}"
                                      Content="Local"
                                      IsChecked="{x:Bind ViewModel.IsLocalSelected, Mode=OneWay}"
                                      Style="{StaticResource MangaLibrarySurfaceButtonStyle}" />
                        <ToggleButton x:Uid="MangaLibraryOnlineSurfaceButton"
                                      AutomationProperties.AutomationId="MangaLibraryOnlineSurfaceButton"
                                      Command="{x:Bind ViewModel.SelectOnlineCommand}"
                                      Content="Online"
                                      IsChecked="{x:Bind ViewModel.IsOnlineSelected, Mode=OneWay}"
                                      Style="{StaticResource MangaLibrarySurfaceButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </CommandBar.Content>
            <CommandBar.PrimaryCommands>
                <AppBarButton x:Uid="MangaLibraryRefreshButton"
                              AutomationProperties.AutomationId="RefreshMangaLibraryButton"
                              Command="{x:Bind ViewModel.RefreshCommand}"
                              Icon="Refresh"
                              Label="Refresh"
                              Visibility="{x:Bind ViewModel.ShowLocalLibraryActions, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />
                <AppBarButton x:Uid="MangaLibraryRefreshOnlineButton"
                              AutomationProperties.AutomationId="RefreshOnlineMangaLibraryButton"
                              Command="{x:Bind ViewModel.RefreshOnlineLibraryCommand}"
                              Icon="Refresh"
                              Label="Refresh"
                              Visibility="{x:Bind ViewModel.ShowOnlineLibraryActions, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />
                <AppBarButton x:Uid="MangaLibraryImportFolderButton"
                              AutomationProperties.AutomationId="ImportMangaFolderButton"
                              Command="{x:Bind ViewModel.ImportFolderCommand}"
                              Icon="Folder"
                              Label="Import folder"
                              Visibility="{x:Bind ViewModel.ShowLocalLibraryActions, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />
                <AppBarButton x:Uid="MangaLibraryImportFileButton"
                              AutomationProperties.AutomationId="ImportMangaFileButton"
                              Command="{x:Bind ViewModel.ImportFileCommand}"
                              Icon="Add"
                              Label="Import manga"
                              Visibility="{x:Bind ViewModel.ShowLocalLibraryActions, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />
            </CommandBar.PrimaryCommands>
        </CommandBar>

        <Grid Grid.Row="1"
              Visibility="{x:Bind ViewModel.IsLocalLibraryVisible, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <ItemsRepeater Margin="20,0,36,24"
                               ItemTemplate="{StaticResource MangaBookTemplate}"
                               ItemsSource="{x:Bind ViewModel.Books, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout MinItemWidth="180"
                                           MinItemHeight="326"
                                           MinColumnSpacing="12"
                                           MinRowSpacing="16"
                                           ItemsJustification="Start" />
                    </ItemsRepeater.Layout>
                </ItemsRepeater>
            </ScrollViewer>

            <TextBlock x:Uid="MangaLibraryEmptyTitleText"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Style="{StaticResource BodyLargeStrongTextBlockStyle}"
                       Text="No manga imported."
                       Visibility="{x:Bind ViewModel.IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />

            <ProgressRing Width="60"
                          Height="60"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                          Visibility="{x:Bind ViewModel.IsLoading, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />
        </Grid>

        <Grid Grid.Row="1"
              Visibility="{x:Bind ViewModel.IsOnlineLibraryVisible, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <ItemsRepeater Margin="20,0,36,24"
                               ItemTemplate="{StaticResource RemoteMangaBookTemplate}"
                               ItemsSource="{x:Bind ViewModel.OnlineBooks, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout MinItemWidth="180"
                                           MinItemHeight="326"
                                           MinColumnSpacing="12"
                                           MinRowSpacing="16"
                                           ItemsJustification="Start" />
                    </ItemsRepeater.Layout>
                </ItemsRepeater>
            </ScrollViewer>

            <StackPanel MaxWidth="520"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="12"
                        Visibility="{x:Bind ViewModel.ShowOnlinePlaceholder, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
                <FontIcon HorizontalAlignment="Center"
                          FontSize="48"
                          Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                          Glyph="&#xE774;" />
                <TextBlock HorizontalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="{x:Bind ViewModel.OnlineStatusMessage, Mode=OneWay}"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
                <Button x:Uid="MangaLibraryOnlineBrowseButton"
                        HorizontalAlignment="Center"
                        AutomationProperties.AutomationId="MangaOnlineBrowseButton"
                        Click="MangaOnlineBrowseButton_Click"
                        Content="Browse / Connect" />
            </StackPanel>

            <ProgressRing Width="60"
                          Height="60"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          IsActive="{x:Bind ViewModel.IsOnlineLoading, Mode=OneWay}"
                          Visibility="{x:Bind ViewModel.IsOnlineLoading, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />
        </Grid>

        <manga:RemoteMangaDetailView Grid.RowSpan="2"
                                     ViewModel="{x:Bind ViewModel, Mode=OneWay}" />
    </Grid>
</Page>
