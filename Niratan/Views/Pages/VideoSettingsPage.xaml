<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="Niratan.Views.Pages.VideoSettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
      xmlns:ui="using:CommunityToolkit.WinUI"
      mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="VideoSectionHeaderStyle" BasedOn="{StaticResource BodyStrongTextBlockStyle}" TargetType="TextBlock">
            <Style.Setters>
                <Setter Property="Margin" Value="1,30,0,6" />
            </Style.Setters>
        </Style>
        <Style x:Key="VideoSettingsValueTextStyle" BasedOn="{StaticResource CaptionTextBlockStyle}" TargetType="TextBlock">
            <Style.Setters>
                <Setter Property="MinWidth" Value="56" />
                <Setter Property="TextAlignment" Value="Right" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style.Setters>
        </Style>
    </Page.Resources>

    <Grid RowDefinitions="Auto,*">
        <StackPanel Padding="20,14,36,16"
                    Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Center">
            <Button x:Name="VideoSettingsBackButton"
                    x:Uid="VideoSettingsBackButton"
                    Width="36"
                    Height="36"
                    Padding="0"
                    AutomationProperties.AutomationId="VideoSettingsBackButton"
                    Click="BackButton_Click">
                <FontIcon Glyph="&#xE72B;" />
            </Button>
            <FontIcon FontSize="24" Glyph="&#xE768;" />
            <TextBlock x:Uid="VideoSettingsPageTitle"
                       VerticalAlignment="Center"
                       Style="{StaticResource TitleTextBlockStyle}"
                       Text="Video Settings" />
        </StackPanel>

        <ScrollViewer Grid.Row="1">
            <Grid Padding="16,0,16,16">
                <StackPanel MaxWidth="1280" HorizontalAlignment="Stretch" Spacing="4">
                    <TextBlock x:Uid="VideoPlaybackSectionHeader"
                               Style="{StaticResource VideoSectionHeaderStyle}"
                               Text="Playback" />

                    <toolkit:SettingsCard x:Uid="VideoAutoPlayNextCard"
                                          HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Stretch"
                                          HeaderIcon="{ui:FontIcon Glyph=&#xE892;}">
                        <ToggleSwitch x:Uid="VideoAutoPlayNextToggle"
                                      AutomationProperties.AutomationId="VideoAutoPlayNextToggle"
                                      IsOn="{x:Bind ViewModel.AutoPlayNextEpisode, Mode=TwoWay}" />
                    </toolkit:SettingsCard>

                    <toolkit:SettingsCard x:Uid="VideoRememberPlaybackStateCard"
                                          HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Stretch"
                                          HeaderIcon="{ui:FontIcon Glyph=&#xE81C;}">
                        <ToggleSwitch x:Uid="VideoRememberPlaybackStateToggle"
                                      AutomationProperties.AutomationId="VideoRememberPlaybackStateToggle"
                                      IsOn="{x:Bind ViewModel.RememberPlaybackState, Mode=TwoWay}" />
                    </toolkit:SettingsCard>

                    <toolkit:SettingsCard x:Uid="VideoSeekIntervalCard"
                                          HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Stretch"
                                          HeaderIcon="{ui:FontIcon Glyph=&#xE96F;}">
                        <NumberBox Width="160"
                                   AutomationProperties.AutomationId="VideoSeekIntervalNumberBox"
                                   Minimum="1"
                                   Maximum="60"
                                   SmallChange="1"
                                   LargeChange="5"
                                   SpinButtonPlacementMode="Compact"
                                   Value="{x:Bind ViewModel.SeekIntervalSecondsValue, Mode=TwoWay}" />
                    </toolkit:SettingsCard>

                    <toolkit:SettingsCard x:Uid="VideoMiningHistoryLimitCard"
                                          HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Stretch"
                                          HeaderIcon="{ui:FontIcon Glyph=&#xE8F1;}">
                        <NumberBox Width="160"
                                   AutomationProperties.AutomationId="VideoMiningHistoryLimitNumberBox"
                                   Minimum="0"
                                   SmallChange="1"
                                   LargeChange="10"
                                   SpinButtonPlacementMode="Compact"
                                   Value="{x:Bind ViewModel.MiningHistoryLimitValue, Mode=TwoWay}" />
                    </toolkit:SettingsCard>

                    <toolkit:SettingsCard x:Uid="VideoKeyboardShortcutsCard"
                                          HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Stretch"
                                          HeaderIcon="{ui:FontIcon Glyph=&#xE765;}">
                        <Button x:Uid="VideoKeyboardShortcutsButton"
                                AutomationProperties.AutomationId="VideoKeyboardShortcutsButton"
                                Click="KeyboardShortcutsButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8A7;" />
                                <TextBlock x:Uid="SettingsOpenText" Text="Open" />
                            </StackPanel>
                        </Button>
                    </toolkit:SettingsCard>

                    <TextBlock x:Uid="VideoEngineSectionHeader"
                               Style="{StaticResource VideoSectionHeaderStyle}"
                               Text="Engine" />

                    <toolkit:SettingsCard x:Uid="VideoHardwareDecodingCard"
                                          HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Stretch"
                                          HeaderIcon="{ui:FontIcon Glyph=&#xE7F8;}">
                        <ToggleSwitch x:Uid="VideoHardwareDecodingToggle"
                                      AutomationProperties.AutomationId="VideoHardwareDecodingToggle"
                                      IsOn="{x:Bind ViewModel.HardwareDecodingEnabled, Mode=TwoWay}" />
                    </toolkit:SettingsCard>

                    <toolkit:SettingsCard x:Uid="VideoDeinterlacingCard"
                                          HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Stretch"
                                          HeaderIcon="{ui:FontIcon Glyph=&#xE9A6;}">
                        <ToggleSwitch x:Uid="VideoDeinterlacingToggle"
                                      AutomationProperties.AutomationId="VideoDeinterlacingToggle"
                                      IsOn="{x:Bind ViewModel.DeinterlacingEnabled, Mode=TwoWay}" />
                    </toolkit:SettingsCard>

                    <toolkit:SettingsCard x:Uid="VideoHdrEnhancementCard"
                                          HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Stretch"
                                          HeaderIcon="{ui:FontIcon Glyph=&#xE706;}">
                        <ToggleSwitch x:Uid="VideoHdrEnhancementToggle"
                                      AutomationProperties.AutomationId="VideoHdrEnhancementToggle"
                                      IsOn="{x:Bind ViewModel.HdrEnhancementEnabled, Mode=TwoWay}" />
                    </toolkit:SettingsCard>

                    <TextBlock x:Uid="VideoEqualizerSectionHeader"
                               Style="{StaticResource VideoSectionHeaderStyle}"
                               Text="Equalizer" />

                    <toolkit:SettingsCard x:Uid="VideoBrightnessCard"
                                          HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Stretch"
                                          HeaderIcon="{ui:FontIcon Glyph=&#xE706;}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Slider Width="260"
                                    Minimum="-100"
                                    Maximum="100"
                                    StepFrequency="1"
                                    AutomationProperties.AutomationId="VideoBrightnessSlider"
                                    Value="{x:Bind ViewModel.VideoBrightness, Mode=TwoWay}" />
                            <TextBlock Text="{x:Bind ViewModel.VideoBrightnessText, Mode=OneWay}"
                                       Style="{StaticResource VideoSettingsValueTextStyle}" />
                        </StackPanel>
                    </toolkit:SettingsCard>

                    <toolkit:SettingsCard x:Uid="VideoContrastCard"
                                          HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Stretch"
                                          HeaderIcon="{ui:FontIcon Glyph=&#xE790;}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Slider Width="260"
                                    Minimum="-100"
                                    Maximum="100"
                                    StepFrequency="1"
                                    AutomationProperties.AutomationId="VideoContrastSlider"
                                    Value="{x:Bind ViewModel.VideoContrast, Mode=TwoWay}" />
                            <TextBlock Text="{x:Bind ViewModel.VideoContrastText, Mode=OneWay}"
                                       Style="{StaticResource VideoSettingsValueTextStyle}" />
                        </StackPanel>
                    </toolkit:SettingsCard>

                    <toolkit:SettingsCard x:Uid="VideoSaturationCard"
                                          HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Stretch"
                                          HeaderIcon="{ui:FontIcon Glyph=&#xE790;}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Slider Width="260"
                                    Minimum="-100"
                                    Maximum="100"
                                    StepFrequency="1"
                                    AutomationProperties.AutomationId="VideoSaturationSlider"
                                    Value="{x:Bind ViewModel.VideoSaturation, Mode=TwoWay}" />
                            <TextBlock Text="{x:Bind ViewModel.VideoSaturationText, Mode=OneWay}"
                                       Style="{StaticResource VideoSettingsValueTextStyle}" />
                        </StackPanel>
                    </toolkit:SettingsCard>

                    <toolkit:SettingsCard x:Uid="VideoGammaCard"
                                          HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Stretch"
                                          HeaderIcon="{ui:FontIcon Glyph=&#xE790;}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Slider Width="260"
                                    Minimum="-100"
                                    Maximum="100"
                                    StepFrequency="1"
                                    AutomationProperties.AutomationId="VideoGammaSlider"
                                    Value="{x:Bind ViewModel.VideoGamma, Mode=TwoWay}" />
                            <TextBlock Text="{x:Bind ViewModel.VideoGammaText, Mode=OneWay}"
                                       Style="{StaticResource VideoSettingsValueTextStyle}" />
                        </StackPanel>
                    </toolkit:SettingsCard>

                    <toolkit:SettingsCard x:Uid="VideoHueCard"
                                          HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Stretch"
                                          HeaderIcon="{ui:FontIcon Glyph=&#xE790;}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Slider Width="260"
                                    Minimum="-100"
                                    Maximum="100"
                                    StepFrequency="1"
                                    AutomationProperties.AutomationId="VideoHueSlider"
                                    Value="{x:Bind ViewModel.VideoHue, Mode=TwoWay}" />
                            <TextBlock Text="{x:Bind ViewModel.VideoHueText, Mode=OneWay}"
                                       Style="{StaticResource VideoSettingsValueTextStyle}" />
                        </StackPanel>
                    </toolkit:SettingsCard>

                    <TextBlock x:Uid="VideoSubtitleAppearanceSectionHeader"
                               Style="{StaticResource VideoSectionHeaderStyle}"
                               Text="Subtitle Appearance" />

                    <toolkit:SettingsCard x:Uid="VideoSubtitleFontFamilyCard"
                                          HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Stretch"
                                          HeaderIcon="{ui:FontIcon Glyph=&#xE8D2;}">
                        <ComboBox Width="240"
                                  AutomationProperties.AutomationId="VideoSubtitleFontFamilyComboBox"
                                  DisplayMemberPath="Name"
                                  ItemsSource="{x:Bind ViewModel.AvailableSubtitleFonts}"
                                  SelectedValuePath="SubtitleFontFamily"
                                  SelectedValue="{x:Bind ViewModel.SubtitleFontFamily, Mode=TwoWay}" />
                    </toolkit:SettingsCard>

                    <toolkit:SettingsCard x:Uid="VideoSubtitleFontSizeCard"
                                          HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Stretch"
                                          HeaderIcon="{ui:FontIcon Glyph=&#xE8D2;}">
                        <NumberBox Width="160"
                                   AutomationProperties.AutomationId="VideoSubtitleFontSizeNumberBox"
                                   Minimum="12"
                                   Maximum="72"
                                   SmallChange="1"
                                   LargeChange="4"
                                   SpinButtonPlacementMode="Compact"
                                   Value="{x:Bind ViewModel.SubtitleFontSizeValue, Mode=TwoWay}" />
                    </toolkit:SettingsCard>

                    <toolkit:SettingsCard x:Uid="VideoSubtitleFontWeightCard"
                                          HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Stretch"
                                          HeaderIcon="{ui:FontIcon Glyph=&#xE8D2;}">
                        <NumberBox Width="160"
                                   AutomationProperties.AutomationId="VideoSubtitleFontWeightNumberBox"
                                   Minimum="100"
                                   Maximum="900"
                                   SmallChange="100"
                                   LargeChange="200"
                                   SpinButtonPlacementMode="Compact"
                                   Value="{x:Bind ViewModel.SubtitleFontWeightValue, Mode=TwoWay}" />
                    </toolkit:SettingsCard>

                    <toolkit:SettingsCard x:Uid="VideoSubtitleShadowRadiusCard"
                                          HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Stretch"
                                          HeaderIcon="{ui:FontIcon Glyph=&#xE7B3;}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Slider Width="260"
                                    Minimum="0"
                                    Maximum="10"
                                    StepFrequency="0.5"
                                    AutomationProperties.AutomationId="VideoSubtitleShadowRadiusSlider"
                                    Value="{x:Bind ViewModel.SubtitleShadowRadius, Mode=TwoWay}" />
                            <TextBlock Text="{x:Bind ViewModel.SubtitleShadowRadiusText, Mode=OneWay}"
                                       Style="{StaticResource VideoSettingsValueTextStyle}" />
                        </StackPanel>
                    </toolkit:SettingsCard>

                    <toolkit:SettingsCard x:Uid="VideoSubtitleBackgroundOpacityCard"
                                          HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Stretch"
                                          HeaderIcon="{ui:FontIcon Glyph=&#xE790;}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Slider Width="260"
                                    Minimum="0"
                                    Maximum="1"
                                    StepFrequency="0.05"
                                    AutomationProperties.AutomationId="VideoSubtitleBackgroundOpacitySlider"
                                    Value="{x:Bind ViewModel.SubtitleBackgroundOpacity, Mode=TwoWay}" />
                            <TextBlock Text="{x:Bind ViewModel.SubtitleBackgroundOpacityText, Mode=OneWay}"
                                       Style="{StaticResource VideoSettingsValueTextStyle}" />
                        </StackPanel>
                    </toolkit:SettingsCard>

                    <toolkit:SettingsCard x:Uid="VideoSubtitleBackgroundDisabledCard"
                                          HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Stretch"
                                          HeaderIcon="{ui:FontIcon Glyph=&#xE711;}">
                        <ToggleSwitch x:Uid="VideoSubtitleBackgroundDisabledToggle"
                                      AutomationProperties.AutomationId="VideoSubtitleBackgroundDisabledToggle"
                                      IsOn="{x:Bind ViewModel.SubtitleBackgroundDisabled, Mode=TwoWay}" />
                    </toolkit:SettingsCard>

                    <toolkit:SettingsCard x:Uid="VideoSubtitleVerticalPositionCard"
                                          HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Stretch"
                                          HeaderIcon="{ui:FontIcon Glyph=&#xE74A;}">
                        <Grid ColumnDefinitions="Auto,*,Auto"
                              ColumnSpacing="10">
                            <Grid Width="24" Height="18">
                                <Border BorderBrush="{ThemeResource TextFillColorSecondaryBrush}"
                                        BorderThickness="1"
                                        CornerRadius="2" />
                                <Border Height="4"
                                        Margin="3"
                                        VerticalAlignment="Top"
                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                        CornerRadius="1" />
                            </Grid>
                            <Slider Grid.Column="1"
                                    Width="260"
                                    Minimum="0"
                                    Maximum="1"
                                    StepFrequency="0.01"
                                    AutomationProperties.AutomationId="VideoSubtitleVerticalPositionSlider"
                                    Value="{x:Bind ViewModel.SubtitleVerticalPosition, Mode=TwoWay}" />
                            <Grid Grid.Column="2" Width="24" Height="18">
                                <Border BorderBrush="{ThemeResource TextFillColorSecondaryBrush}"
                                        BorderThickness="1"
                                        CornerRadius="2" />
                                <Border Height="4"
                                        Margin="3"
                                        VerticalAlignment="Bottom"
                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                        CornerRadius="1" />
                            </Grid>
                        </Grid>
                    </toolkit:SettingsCard>

                    <TextBlock x:Uid="VideoSubtitleColorsSectionHeader"
                               Style="{StaticResource VideoSectionHeaderStyle}"
                               Text="Subtitle Colors" />

                    <toolkit:SettingsCard x:Uid="VideoSubtitleColorCard"
                                          HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Stretch"
                                          HeaderIcon="{ui:FontIcon Glyph=&#xE790;}">
                        <TextBox Width="160"
                                 AutomationProperties.AutomationId="VideoSubtitleColorTextBox"
                                 Text="{x:Bind ViewModel.SubtitleColorHex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </toolkit:SettingsCard>

                    <toolkit:SettingsCard x:Uid="VideoSubtitleLookupHighlightColorCard"
                                          HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Stretch"
                                          HeaderIcon="{ui:FontIcon Glyph=&#xE790;}">
                        <TextBox Width="160"
                                 AutomationProperties.AutomationId="VideoSubtitleLookupHighlightColorTextBox"
                                 Text="{x:Bind ViewModel.SubtitleLookupHighlightColorHex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </toolkit:SettingsCard>

                    <toolkit:SettingsCard x:Uid="VideoSubtitleLookupHighlightTextColorCard"
                                          HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Stretch"
                                          HeaderIcon="{ui:FontIcon Glyph=&#xE790;}">
                        <TextBox Width="160"
                                 AutomationProperties.AutomationId="VideoSubtitleLookupHighlightTextColorTextBox"
                                 Text="{x:Bind ViewModel.SubtitleLookupHighlightTextColorHex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </toolkit:SettingsCard>

                    <TextBlock x:Uid="VideoSubtitleMaskSectionHeader"
                               Style="{StaticResource VideoSectionHeaderStyle}"
                               Text="Subtitle Mask" />

                    <toolkit:SettingsCard x:Uid="VideoSubtitleMaskCard"
                                          HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Stretch"
                                          HeaderIcon="{ui:FontIcon Glyph=&#xE8A6;}">
                        <ToggleSwitch x:Uid="VideoSubtitleMaskToggle"
                                      AutomationProperties.AutomationId="VideoSubtitleMaskToggle"
                                      IsOn="{x:Bind ViewModel.SubtitleMaskEnabled, Mode=TwoWay}" />
                    </toolkit:SettingsCard>

                    <toolkit:SettingsCard x:Uid="VideoSubtitleMaskModeCard"
                                          HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Stretch"
                                          HeaderIcon="{ui:FontIcon Glyph=&#xE8A6;}">
                        <ComboBox MinWidth="180"
                                  AutomationProperties.AutomationId="VideoSubtitleMaskModeComboBox"
                                  DisplayMemberPath="Label"
                                  ItemsSource="{x:Bind ViewModel.AvailableSubtitleMaskModes}"
                                  SelectedValue="{x:Bind ViewModel.SelectedSubtitleMaskMode, Mode=TwoWay}"
                                  SelectedValuePath="Mode" />
                    </toolkit:SettingsCard>

                    <toolkit:SettingsCard x:Uid="VideoSubtitleMaskBlurRadiusCard"
                                          HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Stretch"
                                          HeaderIcon="{ui:FontIcon Glyph=&#xE8A6;}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Slider Width="260"
                                    Minimum="0"
                                    Maximum="20"
                                    StepFrequency="1"
                                    AutomationProperties.AutomationId="VideoSubtitleMaskBlurRadiusSlider"
                                    Value="{x:Bind ViewModel.SubtitleMaskBlurRadius, Mode=TwoWay}" />
                            <TextBlock Text="{x:Bind ViewModel.SubtitleMaskBlurRadiusText, Mode=OneWay}"
                                       Style="{StaticResource VideoSettingsValueTextStyle}" />
                        </StackPanel>
                    </toolkit:SettingsCard>

                    <toolkit:SettingsCard x:Uid="VideoSubtitleMaskHiddenOpacityCard"
                                          HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Stretch"
                                          HeaderIcon="{ui:FontIcon Glyph=&#xE8A6;}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Slider Width="260"
                                    Minimum="0"
                                    Maximum="1"
                                    StepFrequency="0.05"
                                    AutomationProperties.AutomationId="VideoSubtitleMaskHiddenOpacitySlider"
                                    Value="{x:Bind ViewModel.SubtitleMaskHiddenOpacity, Mode=TwoWay}" />
                            <TextBlock Text="{x:Bind ViewModel.SubtitleMaskHiddenOpacityText, Mode=OneWay}"
                                       Style="{StaticResource VideoSettingsValueTextStyle}" />
                        </StackPanel>
                    </toolkit:SettingsCard>

                    <TextBlock x:Uid="VideoMetadataSectionHeader"
                               Style="{StaticResource VideoSectionHeaderStyle}"
                               Text="Library metadata" />

                    <toolkit:SettingsCard x:Uid="VideoMetadataPrivacyCard"
                                          HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Stretch"
                                          HeaderIcon="{ui:FontIcon Glyph=&#xE72E;}">
                        <Grid Width="560"
                              MaxWidth="560"
                              ColumnDefinitions="*,Auto"
                              ColumnSpacing="16">
                            <TextBlock x:Uid="VideoMetadataPrivacyToggleLabel"
                                       Text="Enable online metadata queries"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center" />
                            <ToggleSwitch Grid.Column="1"
                                          AutomationProperties.AutomationId="VideoMetadataPrivacyToggle"
                                          HorizontalAlignment="Right"
                                          IsOn="{x:Bind ViewModel.OnlineMetadataConsentAccepted, Mode=TwoWay}" />
                        </Grid>
                    </toolkit:SettingsCard>

                    <toolkit:SettingsCard x:Uid="VideoMetadataProvidersCard"
                                          HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Stretch"
                                          HeaderIcon="{ui:FontIcon Glyph=&#xE774;}">
                        <StackPanel Width="560" Spacing="8">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <TextBlock x:Uid="VideoMetadataTmdbToggleLabel"
                                           Text="TMDB — movies, drama, and mainstream anime"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center" />
                                <ToggleSwitch Grid.Column="1"
                                              AutomationProperties.AutomationId="VideoMetadataTmdbToggle"
                                              HorizontalAlignment="Right"
                                              IsOn="{x:Bind ViewModel.TmdbMetadataEnabled, Mode=TwoWay}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <TextBlock x:Uid="VideoMetadataTvMazeToggleLabel"
                                           Text="TVmaze — television supplement (CC BY-SA)"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center" />
                                <ToggleSwitch Grid.Column="1"
                                              AutomationProperties.AutomationId="VideoMetadataTvMazeToggle"
                                              HorizontalAlignment="Right"
                                              IsOn="{x:Bind ViewModel.TvMazeMetadataEnabled, Mode=TwoWay}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <TextBlock x:Uid="VideoMetadataAniListToggleLabel"
                                           Text="AniList — anime discovery and recommendations"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center" />
                                <ToggleSwitch Grid.Column="1"
                                              AutomationProperties.AutomationId="VideoMetadataAniListToggle"
                                              HorizontalAlignment="Right"
                                              IsOn="{x:Bind ViewModel.AniListMetadataEnabled, Mode=TwoWay}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <TextBlock x:Uid="VideoMetadataAniDbToggleLabel"
                                           Text="AniDB — official weekly title index"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center" />
                                <ToggleSwitch Grid.Column="1"
                                              AutomationProperties.AutomationId="VideoMetadataAniDbToggle"
                                              HorizontalAlignment="Right"
                                              IsOn="{x:Bind ViewModel.AniDbMetadataEnabled, Mode=TwoWay}" />
                            </Grid>
                            <TextBlock x:Uid="VideoMetadataTvDbDisabledText"
                                       Text="TheTVDB: waiting for project authorization"
                                       TextWrapping="Wrap" />
                            <TextBlock x:Uid="VideoMetadataTmdbNoticeText"
                                       Text="This product uses the TMDB API but is not endorsed or certified by TMDB."
                                       TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <HyperlinkButton x:Uid="VideoMetadataTvMazeLink" NavigateUri="https://www.tvmaze.com/api" />
                                <HyperlinkButton x:Uid="VideoMetadataAniListLink" NavigateUri="https://anilist.co/" />
                                <HyperlinkButton x:Uid="VideoMetadataAniDbLink" NavigateUri="https://anidb.net/" />
                                <HyperlinkButton x:Uid="VideoMetadataTvDbLink" NavigateUri="https://thetvdb.com/" />
                            </StackPanel>
                        </StackPanel>
                    </toolkit:SettingsCard>

                    <toolkit:SettingsCard x:Uid="VideoDiscoverySettingsCard"
                                          HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Stretch"
                                          HeaderIcon="{ui:FontIcon Glyph=&#xE8B4;}">
                        <StackPanel Width="560" Spacing="8">
                            <TextBox x:Uid="VideoDiscoveryProviderOrderBox"
                                     AutomationProperties.AutomationId="VideoDiscoveryProviderOrderBox"
                                     HorizontalAlignment="Stretch"
                                     Text="{x:Bind ViewModel.DiscoveryProviderOrderText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <TextBlock x:Uid="VideoDiscoveryTmdbRecommendationsLabel"
                                           Text="TMDB recommendation groups"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center" />
                                <ToggleSwitch Grid.Column="1"
                                              AutomationProperties.AutomationId="VideoDiscoveryTmdbRecommendationsToggle"
                                              HorizontalAlignment="Right"
                                              IsOn="{x:Bind ViewModel.TmdbRecommendationsEnabled, Mode=TwoWay}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <TextBlock x:Uid="VideoDiscoveryAniListRecommendationsLabel"
                                           Text="AniList recommendation groups"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center" />
                                <ToggleSwitch Grid.Column="1"
                                              AutomationProperties.AutomationId="VideoDiscoveryAniListRecommendationsToggle"
                                              HorizontalAlignment="Right"
                                              IsOn="{x:Bind ViewModel.AniListRecommendationsEnabled, Mode=TwoWay}" />
                            </Grid>
                        </StackPanel>
                    </toolkit:SettingsCard>

                    <toolkit:SettingsCard x:Uid="VideoAniDbClientCard"
                                          HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Stretch"
                                          HeaderIcon="{ui:FontIcon Glyph=&#xE8D7;}">
                        <StackPanel Width="560" Spacing="8">
                            <TextBlock Text="{x:Bind ViewModel.AniDbCredentialStatusText, Mode=OneWay}" />
                            <TextBox x:Name="AniDbUsernameBox"
                                     x:Uid="VideoAniDbUsernameBox"
                                     AutomationProperties.AutomationId="VideoAniDbUsernameBox" />
                            <PasswordBox x:Name="AniDbPasswordBox"
                                         x:Uid="VideoAniDbPasswordBox"
                                         AutomationProperties.AutomationId="VideoAniDbPasswordBox" />
                            <TextBox x:Uid="VideoAniDbClientIdBox"
                                     AutomationProperties.AutomationId="VideoAniDbClientIdBox"
                                     Text="{x:Bind ViewModel.AniDbClientId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <TextBlock x:Uid="VideoAniDbClientVersionLabel" VerticalAlignment="Center" />
                                <NumberBox Grid.Column="1" Width="120" Minimum="1" Maximum="999"
                                           Value="{x:Bind ViewModel.AniDbClientVersion, Mode=TwoWay}" />
                            </Grid>
                            <TextBox x:Uid="VideoAniDbHttpClientIdBox"
                                     AutomationProperties.AutomationId="VideoAniDbHttpClientIdBox"
                                     Text="{x:Bind ViewModel.AniDbHttpClientId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <TextBlock x:Uid="VideoAniDbHttpClientVersionLabel" VerticalAlignment="Center" />
                                <NumberBox Grid.Column="1" Width="120" Minimum="1" Maximum="999"
                                           Value="{x:Bind ViewModel.AniDbHttpClientVersion, Mode=TwoWay}" />
                            </Grid>
                            <TextBox x:Uid="VideoAniDbUdpServerHostBox"
                                     AutomationProperties.AutomationId="VideoAniDbUdpServerHostBox"
                                     Text="{x:Bind ViewModel.AniDbUdpServerHost, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <TextBlock x:Uid="VideoAniDbUdpServerPortLabel" VerticalAlignment="Center" />
                                <NumberBox Grid.Column="1" Width="120" Minimum="1" Maximum="65535"
                                           Value="{x:Bind ViewModel.AniDbUdpServerPort, Mode=TwoWay}" />
                            </Grid>
                            <TextBox x:Uid="VideoAniDbUdpBindAddressBox"
                                     AutomationProperties.AutomationId="VideoAniDbUdpBindAddressBox"
                                     Text="{x:Bind ViewModel.AniDbUdpBindAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <TextBlock x:Uid="VideoAniDbUdpLocalPortLabel" VerticalAlignment="Center" />
                                <NumberBox Grid.Column="1" Width="120" Minimum="1024" Maximum="65535"
                                           Value="{x:Bind ViewModel.AniDbUdpLocalPort, Mode=TwoWay}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <TextBlock x:Uid="VideoAniDbHashMatchingLabel" VerticalAlignment="Center" />
                                <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.AniDbHashMatchingEnabled, Mode=TwoWay}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <TextBlock x:Uid="VideoAniDbMyListSyncLabel" VerticalAlignment="Center" />
                                <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.AniDbMyListSyncEnabled, Mode=TwoWay}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <TextBlock x:Uid="VideoAniDbAutoAddLabel" VerticalAlignment="Center" />
                                <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.AniDbAutoAddToMyList, Mode=TwoWay}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <TextBlock x:Uid="VideoAniDbReadWatchedLabel" VerticalAlignment="Center" />
                                <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.AniDbMyListReadWatched, Mode=TwoWay}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <TextBlock x:Uid="VideoAniDbReadUnwatchedLabel" VerticalAlignment="Center" />
                                <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.AniDbMyListReadUnwatched, Mode=TwoWay}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <TextBlock x:Uid="VideoAniDbSetWatchedLabel" VerticalAlignment="Center" />
                                <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.AniDbMyListSetWatched, Mode=TwoWay}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <TextBlock x:Uid="VideoAniDbSetUnwatchedLabel" VerticalAlignment="Center" />
                                <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.AniDbMyListSetUnwatched, Mode=TwoWay}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <TextBlock x:Uid="VideoAniDbRelationDepthLabel" VerticalAlignment="Center" />
                                <NumberBox Grid.Column="1" Width="120" Minimum="0" Maximum="5"
                                           Value="{x:Bind ViewModel.AniDbRelationDepth, Mode=TwoWay}" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Uid="VideoAniDbSaveCredentialsButton" Click="SaveAniDbCredentialsButton_Click" />
                                <Button x:Uid="VideoAniDbClearCredentialsButton" Click="ClearAniDbCredentialsButton_Click" />
                                <Button x:Uid="VideoAniDbTestLoginButton" Click="TestAniDbLoginButton_Click" />
                                <Button x:Uid="VideoAniDbSyncMyListButton" Click="SyncAniDbMyListButton_Click" />
                                <HyperlinkButton x:Uid="VideoAniDbRegistrationLink"
                                                 NavigateUri="https://wiki.anidb.net/API" />
                            </StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.AniDbConnectionStatusText, Mode=OneWay}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </toolkit:SettingsCard>

                    <toolkit:SettingsCard x:Uid="VideoMetadataTmdbCredentialCard"
                                          HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Stretch"
                                          HeaderIcon="{ui:FontIcon Glyph=&#xE8D7;}">
                        <StackPanel Width="420" Spacing="8">
                            <TextBlock Text="{x:Bind ViewModel.TmdbCredentialStatusText, Mode=OneWay}" />
                            <PasswordBox x:Name="TmdbTokenBox"
                                         x:Uid="VideoMetadataTmdbTokenBox"
                                         AutomationProperties.AutomationId="VideoMetadataTmdbTokenBox" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Uid="VideoMetadataSaveTmdbTokenButton"
                                        Click="SaveTmdbTokenButton_Click" />
                                <Button x:Uid="VideoMetadataClearTmdbTokenButton"
                                        Click="ClearTmdbTokenButton_Click" />
                                <HyperlinkButton x:Uid="VideoMetadataTmdbAttributionLink"
                                                 NavigateUri="https://www.themoviedb.org/" />
                            </StackPanel>
                        </StackPanel>
                    </toolkit:SettingsCard>

                    <toolkit:SettingsCard x:Uid="VideoJimakuCredentialCard"
                                          HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Stretch"
                                          HeaderIcon="{ui:FontIcon Glyph=&#xE8D7;}">
                        <StackPanel Width="420" Spacing="8">
                            <TextBlock Text="{x:Bind ViewModel.JimakuCredentialStatusText, Mode=OneWay}" />
                            <PasswordBox x:Name="JimakuTokenBox"
                                         x:Uid="VideoJimakuTokenBox"
                                         AutomationProperties.AutomationId="VideoJimakuTokenBox" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Uid="VideoSaveJimakuTokenButton"
                                        Click="SaveJimakuTokenButton_Click" />
                                <Button x:Uid="VideoClearJimakuTokenButton"
                                        Click="ClearJimakuTokenButton_Click" />
                                <HyperlinkButton x:Uid="VideoJimakuAttributionLink"
                                                 NavigateUri="https://jimaku.cc/" />
                            </StackPanel>
                        </StackPanel>
                    </toolkit:SettingsCard>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
