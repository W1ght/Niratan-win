<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="Niratan.Views.Pages.VideoLibraryPage"
      x:Name="ThisPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:converters="using:Niratan.Helpers.UI.Converters"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:pages="using:Niratan.ViewModels.Pages"
      xmlns:videoModels="using:Niratan.Models.Video"
      xmlns:vmc="using:Niratan.ViewModels.Components"
      mc:Ignorable="d">

    <Page.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:EnumToBooleanConverter x:Key="EnumToBooleanConverter" />

        <DataTemplate x:Key="FolderFilterTemplate" x:DataType="pages:VideoLibraryFilterRow">
            <Button Width="220"
                    Margin="0,0,8,6"
                    Padding="10,8"
                    HorizontalContentAlignment="Stretch"
                    Command="{Binding ViewModel.SelectFolderFilterCommand, ElementName=ThisPage}"
                    CommandParameter="{x:Bind}">
                <Grid ColumnDefinitions="Auto,*"
                      ColumnSpacing="10">
                    <FontIcon Glyph="&#xE8B7;"
                              VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1"
                                Spacing="2">
                        <TextBlock Text="{x:Bind DisplayName, Mode=OneTime}"
                                   TextTrimming="CharacterEllipsis"
                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="{x:Bind MetadataText, Mode=OneTime}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="CollectionFilterTemplate" x:DataType="pages:VideoLibraryFilterRow">
            <Button Width="220"
                    Margin="0,0,8,6"
                    Padding="10,8"
                    HorizontalContentAlignment="Stretch"
                    Command="{Binding ViewModel.SelectCollectionFilterCommand, ElementName=ThisPage}"
                    CommandParameter="{x:Bind}">
                <Button.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="Edit smart collection"
                                        Click="EditSmartCollectionMenuItem_Click" />
                        <MenuFlyoutItem Text="Delete collection"
                                        Command="{Binding ViewModel.DeleteCollectionCommand, ElementName=ThisPage}"
                                        CommandParameter="{x:Bind}" />
                    </MenuFlyout>
                </Button.ContextFlyout>
                <Grid ColumnDefinitions="Auto,*"
                      ColumnSpacing="10">
                    <FontIcon Glyph="&#xE8F1;"
                              VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1"
                                Spacing="2">
                        <TextBlock Text="{x:Bind DisplayName, Mode=OneTime}"
                                   TextTrimming="CharacterEllipsis"
                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="{x:Bind MetadataText, Mode=OneTime}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="TagFilterTemplate" x:DataType="pages:VideoLibraryFilterRow">
            <Button Width="180"
                    Margin="0,0,8,6"
                    Padding="10,8"
                    HorizontalContentAlignment="Stretch"
                    Command="{Binding ViewModel.SelectTagFilterCommand, ElementName=ThisPage}"
                    CommandParameter="{x:Bind}">
                <Grid ColumnDefinitions="Auto,*"
                      ColumnSpacing="10">
                    <FontIcon Glyph="&#xE8EC;"
                              VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1"
                                Spacing="2">
                        <TextBlock Text="{x:Bind DisplayName, Mode=OneTime}"
                                   TextTrimming="CharacterEllipsis"
                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="{x:Bind MetadataText, Mode=OneTime}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="VideoMetadataTaskTemplate"
                      x:DataType="vmc:VideoMetadataTaskViewModel">
            <Grid Padding="0,8"
                  ColumnDefinitions="*,Auto"
                  ColumnSpacing="12">
                <StackPanel Spacing="2">
                    <TextBlock Text="{x:Bind TaskTitle}"
                               Style="{StaticResource BodyStrongTextBlockStyle}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{x:Bind StatusText}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{x:Bind ProgressText}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{x:Bind UpdatedText}"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock Text="{x:Bind ErrorText}"
                               Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                               TextWrapping="Wrap"
                               Visibility="{x:Bind HasError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="4"
                            VerticalAlignment="Center">
                    <Button x:Uid="VideoMetadataTaskReviewButton"
                            Command="{Binding ViewModel.OpenMetadataReviewCommand, ElementName=ThisPage}"
                            Visibility="{x:Bind HasReviewItems, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <FontIcon Glyph="&#xE7BA;" />
                    </Button>
                    <Button x:Uid="VideoMetadataTaskRetryButton"
                            Command="{Binding ViewModel.RetryMetadataTaskCommand, ElementName=ThisPage}"
                            CommandParameter="{x:Bind}"
                            Visibility="{x:Bind CanRetry, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <FontIcon Glyph="&#xE72C;" />
                    </Button>
                    <Button x:Uid="VideoMetadataTaskCancelButton"
                            Command="{Binding ViewModel.CancelMetadataTaskCommand, ElementName=ThisPage}"
                            CommandParameter="{x:Bind}"
                            Visibility="{x:Bind CanCancel, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <FontIcon Glyph="&#xE711;" />
                    </Button>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="VideoListItemTemplate" x:DataType="vmc:VideoItemViewModel">
            <Grid>
            <Button Padding="0"
                    HorizontalContentAlignment="Stretch"
                    AutomationProperties.AutomationId="{x:Bind AutomationId, Mode=OneTime}"
                    AutomationProperties.Name="{x:Bind Video.Title, Mode=OneTime}"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="VideoButton_Click">
                <Button.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem x:Uid="VideoLibraryPlayMenuItem"
                                        Text="Play"
                                        Command="{Binding ViewModel.OpenVideoCommand, ElementName=ThisPage}"
                                        CommandParameter="{x:Bind}" />
                        <MenuFlyoutItem x:Uid="VideoLibraryPlayFromBeginningMenuItem"
                                        Text="Play from beginning"
                                        Command="{Binding ViewModel.OpenVideoFromBeginningCommand, ElementName=ThisPage}"
                                        CommandParameter="{x:Bind}" />
                        <MenuFlyoutItem Text="Details"
                                        Command="{Binding ViewModel.SelectVideoDetailsCommand, ElementName=ThisPage}"
                                        CommandParameter="{x:Bind}" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Uid="VideoLibraryAddFavoriteMenuItem"
                                        Text="Add to favorites"
                                        Visibility="{x:Bind Video.IsFavorite, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}"
                                        Command="{Binding ViewModel.ToggleFavoriteCommand, ElementName=ThisPage}"
                                        CommandParameter="{x:Bind}" />
                        <MenuFlyoutItem x:Uid="VideoLibraryRemoveFavoriteMenuItem"
                                        Text="Remove from favorites"
                                        Visibility="{x:Bind Video.IsFavorite, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Command="{Binding ViewModel.ToggleFavoriteCommand, ElementName=ThisPage}"
                                        CommandParameter="{x:Bind}" />
                        <MenuFlyoutItem x:Uid="VideoLibraryMarkWatchedMenuItem"
                                        Text="Mark watched"
                                        Command="{Binding ViewModel.MarkWatchedCommand, ElementName=ThisPage}"
                                        CommandParameter="{x:Bind}" />
                        <MenuFlyoutItem x:Uid="VideoLibraryClearProgressMenuItem"
                                        Text="Clear progress"
                                        Command="{Binding ViewModel.ClearProgressCommand, ElementName=ThisPage}"
                                        CommandParameter="{x:Bind}" />
                        <MenuFlyoutItem x:Uid="VideoLibraryRevealFileMenuItem"
                                        Text="Reveal file"
                                        Visibility="{x:Bind Video.IsRemote, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}"
                                        Command="{Binding ViewModel.RevealFileCommand, ElementName=ThisPage}"
                                        CommandParameter="{x:Bind}" />
                        <MenuFlyoutItem x:Uid="VideoLibraryAddToNewCollectionMenuItem"
                                        Text="Add to new collection"
                                        Command="{Binding ViewModel.AddToNewCollectionCommand, ElementName=ThisPage}"
                                        CommandParameter="{x:Bind}" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Uid="VideoLibraryDeleteMenuItem"
                                        Text="Delete"
                                        Command="{Binding ViewModel.DeleteVideoCommand, ElementName=ThisPage}"
                                        CommandParameter="{x:Bind}" />
                    </MenuFlyout>
                </Button.ContextFlyout>
                <Grid MinHeight="96"
                      ColumnDefinitions="144,*"
                      ColumnSpacing="14"
                      Padding="10,8">
                    <Border Width="144"
                            Height="81"
                            CornerRadius="8"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <Grid>
                            <Image Source="{x:Bind ArtworkImage, Mode=OneTime}"
                                   Stretch="UniformToFill"
                                   Visibility="{x:Bind HasArtwork, Mode=OneTime, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <FontIcon Glyph="&#xE714;"
                                      Opacity="0.35"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Visibility="{x:Bind HasArtwork, Mode=OneTime, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}" />
                        </Grid>
                    </Border>
                    <Grid Grid.Column="1"
                          RowDefinitions="Auto,Auto,Auto"
                          RowSpacing="6">
                        <TextBlock Text="{x:Bind Video.Title, Mode=OneTime}"
                                   TextWrapping="WrapWholeWords"
                                   TextTrimming="CharacterEllipsis"
                                   MaxLines="2"
                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Grid.Row="1"
                                   Text="{x:Bind ListMetadataText, Mode=OneWay}"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Grid Grid.Row="2"
                              ColumnDefinitions="120,Auto"
                              ColumnSpacing="10">
                            <ProgressBar Height="4"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="{x:Bind OverallProgressPercent, Mode=OneWay}" />
                            <TextBlock Grid.Column="1"
                                       Text="{x:Bind RemainingText, Mode=OneWay}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                    </Grid>
                </Grid>
            </Button>
                <CheckBox Margin="6"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Top"
                          IsChecked="{x:Bind IsSelected, Mode=OneWay}"
                          Command="{Binding ViewModel.ToggleVideoSelectionCommand, ElementName=ThisPage}"
                          CommandParameter="{x:Bind}"
                          AutomationProperties.Name="Select video" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="VideoPosterItemTemplate" x:DataType="vmc:VideoItemViewModel">
            <Grid Width="300"
                  MaxWidth="300"
                  Margin="0,0,12,0">
            <Button Width="300"
                    MaxWidth="300"
                    Padding="0"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch"
                    AutomationProperties.AutomationId="{x:Bind AutomationId, Mode=OneTime}"
                    AutomationProperties.Name="{x:Bind Video.Title, Mode=OneTime}"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="VideoButton_Click">
                <Button.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem x:Uid="VideoLibraryPlayMenuItem"
                                        Text="Play"
                                        Command="{Binding ViewModel.OpenVideoCommand, ElementName=ThisPage}"
                                        CommandParameter="{x:Bind}" />
                        <MenuFlyoutItem x:Uid="VideoLibraryPlayFromBeginningMenuItem"
                                        Text="Play from beginning"
                                        Command="{Binding ViewModel.OpenVideoFromBeginningCommand, ElementName=ThisPage}"
                                        CommandParameter="{x:Bind}" />
                        <MenuFlyoutItem Text="Details"
                                        Command="{Binding ViewModel.SelectVideoDetailsCommand, ElementName=ThisPage}"
                                        CommandParameter="{x:Bind}" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Uid="VideoLibraryAddFavoriteMenuItem"
                                        Text="Add to favorites"
                                        Visibility="{x:Bind Video.IsFavorite, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}"
                                        Command="{Binding ViewModel.ToggleFavoriteCommand, ElementName=ThisPage}"
                                        CommandParameter="{x:Bind}" />
                        <MenuFlyoutItem x:Uid="VideoLibraryRemoveFavoriteMenuItem"
                                        Text="Remove from favorites"
                                        Visibility="{x:Bind Video.IsFavorite, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Command="{Binding ViewModel.ToggleFavoriteCommand, ElementName=ThisPage}"
                                        CommandParameter="{x:Bind}" />
                        <MenuFlyoutItem x:Uid="VideoLibraryMarkWatchedMenuItem"
                                        Text="Mark watched"
                                        Command="{Binding ViewModel.MarkWatchedCommand, ElementName=ThisPage}"
                                        CommandParameter="{x:Bind}" />
                        <MenuFlyoutItem x:Uid="VideoLibraryClearProgressMenuItem"
                                        Text="Clear progress"
                                        Command="{Binding ViewModel.ClearProgressCommand, ElementName=ThisPage}"
                                        CommandParameter="{x:Bind}" />
                        <MenuFlyoutItem x:Uid="VideoLibraryRevealFileMenuItem"
                                        Text="Reveal file"
                                        Visibility="{x:Bind Video.IsRemote, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}"
                                        Command="{Binding ViewModel.RevealFileCommand, ElementName=ThisPage}"
                                        CommandParameter="{x:Bind}" />
                        <MenuFlyoutItem x:Uid="VideoLibraryAddToNewCollectionMenuItem"
                                        Text="Add to new collection"
                                        Command="{Binding ViewModel.AddToNewCollectionCommand, ElementName=ThisPage}"
                                        CommandParameter="{x:Bind}" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Uid="VideoLibraryDeleteMenuItem"
                                        Text="Delete"
                                        Command="{Binding ViewModel.DeleteVideoCommand, ElementName=ThisPage}"
                                        CommandParameter="{x:Bind}" />
                    </MenuFlyout>
                </Button.ContextFlyout>
                <StackPanel Width="300"
                            MaxWidth="300"
                            Spacing="8">
                    <Border Width="300"
                            Height="169"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="8">
                        <Grid>
                            <Image Stretch="UniformToFill"
                                   Source="{x:Bind LandscapeArtworkImage, Mode=OneWay}"
                                   Visibility="{x:Bind HasLandscapeArtwork, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <FontIcon FontSize="44"
                                      Glyph="&#xE714;"
                                      Opacity="0.35"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Visibility="{x:Bind HasLandscapeArtwork, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}" />
                        </Grid>
                    </Border>
                    <StackPanel Width="300"
                                MaxWidth="300"
                                Spacing="5">
                        <Grid ColumnDefinitions="*,Auto"
                              ColumnSpacing="8">
                            <ProgressBar Height="4"
                                         Minimum="0"
                                         Maximum="100"
                                         VerticalAlignment="Center"
                                         Value="{x:Bind OverallProgressPercent, Mode=OneWay}" />
                            <TextBlock Grid.Column="1"
                                       Text="{x:Bind ProgressText, Mode=OneWay}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                        <TextBlock x:Name="VideoPosterTitleText"
                                   Width="300"
                                   MaxWidth="300"
                                   Text="{x:Bind Video.Title, Mode=OneTime}"
                                   TextWrapping="WrapWholeWords"
                                   TextTrimming="CharacterEllipsis"
                                   MaxLines="2"
                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="{x:Bind FolderName, Mode=OneWay}"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{x:Bind WatchStatusText, Mode=OneWay}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </Button>
                <CheckBox Margin="6"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Top"
                          IsChecked="{x:Bind IsSelected, Mode=OneWay}"
                          Command="{Binding ViewModel.ToggleVideoSelectionCommand, ElementName=ThisPage}"
                          CommandParameter="{x:Bind}"
                          AutomationProperties.Name="Select video" />
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <NavigationView x:Name="VideoLibrarySecondaryNavigationView"
                        x:Uid="VideoLibrarySecondaryNavigationView"
                        AlwaysShowHeader="False"
                        IsBackButtonVisible="Collapsed"
                        IsPaneToggleButtonVisible="False"
                        IsSettingsVisible="False"
                        ItemInvoked="VideoLibraryTopNavigationView_ItemInvoked"
                        PaneDisplayMode="Top"
                        SelectionFollowsFocus="Disabled">
            <NavigationView.Resources>
                <Thickness x:Key="NavigationViewContentMargin">0</Thickness>
                <Thickness x:Key="NavigationViewContentGridBorderThickness">1,0,0,0</Thickness>
                <CornerRadius x:Key="NavigationViewContentGridCornerRadius">0</CornerRadius>
            </NavigationView.Resources>

            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="VideoLibraryHomeNavItem"
                                    x:Uid="VideoLibraryTopHomeNavItem"
                                    AutomationProperties.AutomationId="VideoLibraryHomeNavItem"
                                    Content="Home"
                                    Tag="Home">
                </NavigationViewItem>
                <NavigationViewItem x:Name="VideoLibraryDiscoverNavItem"
                                    x:Uid="VideoLibraryTopDiscoverNavItem"
                                    AutomationProperties.AutomationId="VideoLibraryDiscoverNavItem"
                                    Content="Discover"
                                    Tag="Discover">
                </NavigationViewItem>
                <NavigationViewItem x:Name="VideoLibrarySeriesNavItem"
                                    x:Uid="VideoLibraryTopSeriesNavItem"
                                    AutomationProperties.AutomationId="VideoLibrarySeriesNavItem"
                                    Content="Series"
                                    Tag="Series">
                </NavigationViewItem>
                <NavigationViewItem x:Name="VideoLibraryAllVideosNavItem"
                                    x:Uid="VideoLibraryTopAllVideosNavItem"
                                    AutomationProperties.AutomationId="VideoLibraryAllVideosNavItem"
                                    Content="All videos"
                                    Tag="All">
                </NavigationViewItem>
                <NavigationViewItem x:Name="VideoLibrarySourcesNavItem"
                                    x:Uid="VideoLibraryTopImportNavItem"
                                    AutomationProperties.AutomationId="VideoLibrarySourcesNavItem"
                                    Content="Import"
                                    Tag="Sources">
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Grid RowDefinitions="Auto,Auto,*">
                <Grid Grid.Row="0"
                      Padding="20,14,28,16"
                      RowDefinitions="Auto,Auto"
                      ColumnDefinitions="*,156,Auto"
                      ColumnSpacing="12"
                      Visibility="{x:Bind ViewModel.IsLibraryHeaderVisible, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
                    <StackPanel Grid.ColumnSpan="3"
                                Margin="0,0,0,12"
                                VerticalAlignment="Center"
                                Spacing="2"
                                Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="8"
                                    VerticalAlignment="Center">
                            <FontIcon FontSize="24" Glyph="&#xE714;" />
                            <TextBlock Text="{x:Bind ViewModel.CurrentViewTitle, Mode=OneWay}"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource TitleTextBlockStyle}" />
                        </StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.CurrentViewSubtitle, Mode=OneWay}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <TextBox Grid.Row="1"
                             x:Name="VideoLibrarySearchBox"
                             x:Uid="VideoLibrarySearchBox"
                             AutomationProperties.AutomationId="VideoLibrarySearchBox"
                             PlaceholderText="Search videos"
                             Visibility="{x:Bind ViewModel.IsCatalogSearchVisible, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}"
                             VerticalAlignment="Center"
                             Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <ComboBox Grid.Row="1"
                              Grid.Column="1"
                              x:Name="VideoLibrarySortComboBox"
                              x:Uid="VideoLibrarySortComboBox"
                              AutomationProperties.AutomationId="VideoLibrarySortComboBox"
                              AutomationProperties.Name="Sort videos"
                              Visibility="{x:Bind ViewModel.IsCatalogSearchVisible, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}"
                              DisplayMemberPath="DisplayName"
                              ItemsSource="{x:Bind ViewModel.SortOptions, Mode=OneWay}"
                              SelectedValue="{x:Bind ViewModel.SelectedSortOption, Mode=TwoWay}"
                              SelectedValuePath="Value"
                              VerticalAlignment="Center" />

                    <CommandBar Grid.Row="1"
                                Grid.Column="2"
                                DefaultLabelPosition="Right"
                                VerticalAlignment="Center"
                                Visibility="{x:Bind ViewModel.IsSourcesView, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
                        <AppBarButton x:Name="ScanVideoFolderButton"
                                      x:Uid="ScanVideoFolderButton"
                                      AutomationProperties.AutomationId="ScanVideoFolderButton"
                                      Command="{x:Bind ViewModel.ScanFolderCommand}"
                                      Label="Scan folder">
                            <AppBarButton.Icon>
                                <FontIcon Glyph="&#xE8B7;" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                        <AppBarButton x:Name="AddYouTubeLinkButton"
                                      x:Uid="AddYouTubeLinkButton"
                                      AutomationProperties.AutomationId="AddYouTubeLinkButton"
                                      Click="AddYouTubeLinkButton_Click"
                                      Label="YouTube">
                            <AppBarButton.Icon>
                                <FontIcon Glyph="&#xE71B;" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                        <AppBarButton x:Uid="RefreshVideoSourcesButton"
                                      Label="Refresh"
                                      AutomationProperties.AutomationId="RefreshVideoSourcesButton"
                                      IsEnabled="{x:Bind ViewModel.HasSources, Mode=OneWay}"
                                      Command="{x:Bind ViewModel.RefreshAllSourcesCommand}">
                            <AppBarButton.Icon>
                                <FontIcon Glyph="&#xE72C;" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                        <AppBarButton x:Uid="VideoLibraryScrapeAllButton"
                                      Label="Rescrape"
                                      AutomationProperties.AutomationId="VideoLibraryScrapeAllButton"
                                      Command="{x:Bind ViewModel.ScrapeAllMetadataCommand}">
                            <AppBarButton.Icon>
                                <FontIcon Glyph="&#xE774;" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                        <AppBarButton x:Uid="VideoLibraryMetadataTasksButton"
                                      Label="Background tasks"
                                      AutomationProperties.AutomationId="VideoLibraryMetadataTasksButton"
                                      Command="{x:Bind ViewModel.ToggleMetadataTasksCommand}">
                            <AppBarButton.Icon>
                                <FontIcon Glyph="&#xE823;" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                    </CommandBar>
                </Grid>

                <StackPanel Grid.Row="1" Margin="20,0,28,10" Spacing="8">
                    <Grid RowDefinitions="Auto,Auto"
                          RowSpacing="5"
                          Visibility="{x:Bind ViewModel.HasActiveScan, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
                        <TextBlock Text="{x:Bind ViewModel.ActiveScanText, Mode=OneWay}"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <ProgressBar Grid.Row="1"
                                     Height="4"
                                     Minimum="0"
                                     Maximum="100"
                                     IsIndeterminate="{x:Bind ViewModel.IsActiveScanIndeterminate, Mode=OneWay}"
                                     Value="{x:Bind ViewModel.ActiveScanProgress, Mode=OneWay}" />
                    </Grid>
                    <Grid RowDefinitions="Auto,Auto"
                          RowSpacing="5"
                          Visibility="{x:Bind ViewModel.HasActiveMetadataRefresh, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
                        <TextBlock Text="{x:Bind ViewModel.MetadataRefreshText, Mode=OneWay}"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <ProgressBar Grid.Row="1"
                                     Height="4"
                                     Minimum="0"
                                     Maximum="100"
                                     IsIndeterminate="{x:Bind ViewModel.IsMetadataRefreshIndeterminate, Mode=OneWay}"
                                     Value="{x:Bind ViewModel.MetadataRefreshProgress, Mode=OneWay}" />
                    </Grid>
                    <Grid RowDefinitions="Auto,Auto"
                          RowSpacing="5"
                          Visibility="{x:Bind ViewModel.HasBackgroundMetadataTask, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
                        <TextBlock Text="{x:Bind ViewModel.BackgroundMetadataText, Mode=OneWay}"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <ProgressBar Grid.Row="1"
                                     Height="4"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="{x:Bind ViewModel.BackgroundMetadataProgress, Mode=OneWay}" />
                    </Grid>
                    <Border Padding="12,8"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="8"
                            Visibility="{x:Bind ViewModel.IsMetadataTaskPanelVisible, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
                        <Grid RowDefinitions="Auto,Auto"
                              RowSpacing="6">
                            <Grid ColumnDefinitions="*,Auto,Auto,Auto"
                                  ColumnSpacing="6">
                                <StackPanel Spacing="1">
                                    <TextBlock x:Uid="VideoLibraryMetadataTasksHeading"
                                               Style="{StaticResource BodyStrongTextBlockStyle}"
                                               Text="Background tasks" />
                                    <TextBlock Text="{x:Bind ViewModel.MetadataTaskCountText, Mode=OneWay}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <Button x:Uid="VideoLibraryRefreshMetadataTasksButton"
                                        Grid.Column="1"
                                        Command="{x:Bind ViewModel.RefreshMetadataTasksCommand}">
                                    <FontIcon Glyph="&#xE72C;" />
                                </Button>
                                <Button x:Uid="VideoLibraryCloseMetadataTasksButton"
                                        Grid.Column="2"
                                        Command="{x:Bind ViewModel.ToggleMetadataTasksCommand}">
                                    <FontIcon Glyph="&#xE711;" />
                                </Button>
                                <Button x:Uid="VideoLibraryRetryFailedMetadataTasksButton"
                                        Grid.Column="3"
                                        Command="{x:Bind ViewModel.RetryFailedMetadataTasksCommand}">
                                    <FontIcon Glyph="&#xE72C;" />
                                </Button>
                            </Grid>
                            <TextBlock Grid.Row="1"
                                       x:Uid="VideoLibraryMetadataTasksEmptyText"
                                       Text="No background tasks."
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Visibility="{x:Bind ViewModel.HasMetadataTasks, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert, Mode=OneWay}" />
                            <ItemsControl Grid.Row="1"
                                          ItemTemplate="{StaticResource VideoMetadataTaskTemplate}"
                                          ItemsSource="{x:Bind ViewModel.MetadataTasks, Mode=OneWay}"
                                          Visibility="{x:Bind ViewModel.HasMetadataTasks, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />
                        </Grid>
                    </Border>
                </StackPanel>

                <Frame Grid.Row="2"
                       x:Name="DiscoverPageHostFrame"
                       AutomationProperties.AutomationId="VideoLibraryDiscoverPage"
                       Padding="0"
                       Visibility="{x:Bind ViewModel.IsDiscoverView, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />

                <ProgressRing Grid.Row="2"
                              Width="60"
                              Height="60"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              IsActive="{x:Bind ViewModel.IsContentLoading, Mode=OneWay}"
                              Visibility="{x:Bind ViewModel.ShowCatalogLoading, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />

                <TextBlock Grid.Row="2"
                           x:Uid="NoVideosText"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Style="{StaticResource BodyLargeStrongTextBlockStyle}"
                           Text="No videos."
                           Visibility="{x:Bind ViewModel.ShowNoVideos, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />

                <Grid Grid.Row="2"
                      RowDefinitions="Auto,*"
                      Visibility="{x:Bind ViewModel.IsLibraryBrowseView, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
                    <StackPanel Grid.Row="0"
                                Margin="20,0,28,4"
                                Spacing="8">
                        <ItemsControl x:Name="VideoLibraryFolderFilters"
                                      AutomationProperties.AutomationId="VideoLibraryFolderFilters"
                                      ItemTemplate="{StaticResource FolderFilterTemplate}"
                                      ItemsSource="{x:Bind ViewModel.FolderFilters, Mode=OneWay}"
                                      Visibility="{x:Bind ViewModel.IsFoldersView, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsWrapGrid Orientation="Horizontal"
                                                   ItemWidth="228" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <ItemsControl x:Name="VideoLibraryCollectionFilters"
                                      AutomationProperties.AutomationId="VideoLibraryCollectionFilters"
                                      ItemTemplate="{StaticResource CollectionFilterTemplate}"
                                      ItemsSource="{x:Bind ViewModel.CollectionFilters, Mode=OneWay}"
                                      Visibility="{x:Bind ViewModel.IsCollectionsView, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsWrapGrid Orientation="Horizontal"
                                                   ItemWidth="228" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <ItemsControl x:Name="VideoLibraryTagFilters"
                                      AutomationProperties.AutomationId="VideoLibraryTagFilters"
                                      ItemTemplate="{StaticResource TagFilterTemplate}"
                                      ItemsSource="{x:Bind ViewModel.TagFilters, Mode=OneWay}"
                                      Visibility="{x:Bind ViewModel.IsTagsView, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsWrapGrid Orientation="Horizontal"
                                                   ItemWidth="188" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>

                    <Grid Grid.Row="1"
                          Margin="20,0,28,0"
                          ColumnDefinitions="*,Auto"
                          ColumnSpacing="16">
                        <Grid RowDefinitions="Auto,*">
                            <CommandBar Grid.Row="0"
                                        Margin="0,0,0,8"
                                        Visibility="{x:Bind ViewModel.HasSelection, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
                                <AppBarButton Label="Mark selected watched"
                                              Command="{x:Bind ViewModel.MarkSelectedWatchedCommand}">
                                    <AppBarButton.Icon><SymbolIcon Symbol="Accept" /></AppBarButton.Icon>
                                </AppBarButton>
                                <AppBarButton Label="Clear selected progress"
                                              Command="{x:Bind ViewModel.ClearSelectedProgressCommand}">
                                    <AppBarButton.Icon><SymbolIcon Symbol="Clear" /></AppBarButton.Icon>
                                </AppBarButton>
                                <AppBarButton Label="Remove selected"
                                              Command="{x:Bind ViewModel.DeleteSelectedVideosCommand}">
                                    <AppBarButton.Icon><SymbolIcon Symbol="Delete" /></AppBarButton.Icon>
                                </AppBarButton>
                                <AppBarButton Label="Remove missing"
                                              Command="{x:Bind ViewModel.RemoveMissingVideosCommand}">
                                    <AppBarButton.Icon><FontIcon Glyph="&#xE74D;" /></AppBarButton.Icon>
                                </AppBarButton>
                            </CommandBar>

                        <GridView Grid.Row="1"
                                  x:Name="VideoGridView"
                                  AutomationProperties.AutomationId="VideoGridView"
                                  Padding="0,0,16,0"
                                  IsItemClickEnabled="True"
                                  ItemClick="GridView_ItemClick"
                                  ItemTemplate="{StaticResource VideoPosterItemTemplate}"
                                  ItemsSource="{x:Bind ViewModel.Videos, Mode=OneWay}"
                                  SelectionMode="None">
                            <GridView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsWrapGrid Orientation="Horizontal"
                                                   ItemWidth="300"
                                                   ItemHeight="320" />
                                </ItemsPanelTemplate>
                            </GridView.ItemsPanel>
                        </GridView>
                        </Grid>

                        <Border Grid.Column="1"
                                Width="340"
                                Padding="16"
                                BorderThickness="1,0,0,0"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                Visibility="{x:Bind ViewModel.HasSelectedVideo, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
                            <ScrollViewer>
                                <StackPanel Spacing="14">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock x:Uid="VideoLibraryDetailsHeading" Text="Video details" Style="{StaticResource SubtitleTextBlockStyle}" />
                                        <Button Grid.Column="1"
                                                Command="{x:Bind ViewModel.CloseVideoDetailsCommand}">
                                            <FontIcon Glyph="&#xE711;" />
                                        </Button>
                                    </Grid>
                                    <Border Height="170"
                                            CornerRadius="8"
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            Visibility="{x:Bind ViewModel.SelectedVideo.HasBackdrop, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
                                        <Image Source="{x:Bind ViewModel.SelectedVideo.BackdropImage, Mode=OneWay}"
                                               Stretch="UniformToFill" />
                                    </Border>
                                    <TextBlock Text="{x:Bind ViewModel.SelectedVideo.Video.Title, Mode=OneWay}"
                                               Style="{StaticResource TitleTextBlockStyle}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind ViewModel.SelectedVideo.Video.LocalizedSubtitle, Mode=OneWay}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind ViewModel.SelectedVideo.Video.OriginalTitle, Mode=OneWay}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind ViewModel.SelectedVideo.MetadataFactsText, Mode=OneWay}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button x:Uid="VideoLibraryDetailsPlayButton"
                                                Content="Play"
                                                Command="{x:Bind ViewModel.OpenVideoCommand}"
                                                CommandParameter="{x:Bind ViewModel.SelectedVideo}" />
                                        <Button x:Uid="VideoLibraryDetailsPlayFromBeginningButton"
                                                Content="Play from beginning"
                                                Command="{x:Bind ViewModel.OpenVideoFromBeginningCommand}"
                                                CommandParameter="{x:Bind ViewModel.SelectedVideo}" />
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind ViewModel.SelectedVideo.Video.Overview, Mode=OneWay}"
                                               TextWrapping="Wrap" />
                                    <StackPanel Spacing="4"
                                                Visibility="{x:Bind ViewModel.SelectedVideo.Video.HasGenres, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
                                        <TextBlock x:Uid="VideoLibraryDetailsGenresLabel" Text="Genres"
                                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Text="{x:Bind ViewModel.SelectedVideo.Video.GenresText, Mode=OneWay}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Spacing="4"
                                                Visibility="{x:Bind ViewModel.SelectedVideo.Video.HasActors, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
                                        <TextBlock x:Uid="VideoLibraryDetailsCastLabel" Text="Cast"
                                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Text="{x:Bind ViewModel.SelectedVideo.Video.ActorsText, Mode=OneWay}"
                                                   MaxLines="5" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <HyperlinkButton x:Uid="VideoLibraryDetailsProviderLink"
                                                     Content="Metadata source"
                                                     NavigateUri="{x:Bind ViewModel.SelectedVideo.Video.PrimaryProviderSourceUri, Mode=OneWay}"
                                                     Visibility="{x:Bind ViewModel.SelectedVideo.Video.HasProviderSources, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />
                                    <TextBlock x:Uid="VideoMetadataExternalIdsLabel"
                                               Text="External IDs"
                                               Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="{x:Bind ViewModel.SelectedVideo.Video.ExternalIdsText, Mode=OneWay}"
                                               TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Uid="VideoLibraryDetailsMediaInfoLabel"
                                               Text="Media" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="{x:Bind ViewModel.SelectedVideo.ListMetadataText, Mode=OneWay}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.SelectedVideo.Video.FilePath, Mode=OneWay}"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <Button x:Uid="VideoMetadataRefreshSelectedButton"
                                            Content="Refresh metadata"
                                            HorizontalAlignment="Left"
                                            Command="{x:Bind ViewModel.RefreshSelectedMetadataCommand}" />
                                    <StackPanel Visibility="{x:Bind ViewModel.SelectedVideo.Video.NeedsReview, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}"
                                                Spacing="8">
                                        <TextBlock x:Uid="VideoMetadataReviewCandidatesLabel"
                                                   Text="Match candidates"
                                                   Style="{StaticResource SubtitleTextBlockStyle}" />
                                        <ItemsControl ItemsSource="{x:Bind ViewModel.SelectedVideo.Video.MatchCandidates, Mode=OneWay}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="videoModels:VideoMatchCandidateSnapshot">
                                                    <Grid Padding="8" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                        <StackPanel>
                                                            <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                                            <TextBlock Text="{x:Bind Evidence}" TextWrapping="Wrap"
                                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                            <TextBlock Text="{x:Bind ProviderId}"
                                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        </StackPanel>
                                                        <Button Grid.Column="1"
                                                                x:Uid="VideoMetadataBindCandidateButton"
                                                                Content="Preview and bind"
                                                                Command="{Binding ViewModel.BindMatchCandidateCommand, ElementName=ThisPage}"
                                                                CommandParameter="{x:Bind}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                    <TextBox Header="Display title"
                                             Text="{x:Bind ViewModel.SelectedVideoTitleDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Header="Tags"
                                             PlaceholderText="Comma or line separated"
                                             AcceptsReturn="True"
                                             Text="{x:Bind ViewModel.SelectedVideoTagsDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Content="Save metadata"
                                            HorizontalAlignment="Left"
                                            Command="{x:Bind ViewModel.SaveVideoDetailsCommand}" />

                                    <TextBlock Text="Bound subtitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="{x:Bind ViewModel.SelectedVideoSubtitlePath, Mode=OneWay}"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="Bind subtitle"
                                                Command="{x:Bind ViewModel.BindSubtitleCommand}" />
                                        <Button Content="Clear"
                                                Command="{x:Bind ViewModel.ClearBoundSubtitleCommand}" />
                                    </StackPanel>

                                    <TextBlock Text="Collections" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <ItemsControl ItemsSource="{x:Bind ViewModel.ManualCollectionOptions, Mode=OneWay}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="pages:VideoCollectionMembershipOption">
                                                <CheckBox Content="{x:Bind Collection.Name, Mode=OneWay}"
                                                          IsChecked="{x:Bind IsIncluded, Mode=TwoWay}"
                                                          Command="{Binding ViewModel.SetSelectedCollectionMembershipCommand, ElementName=ThisPage}"
                                                          CommandParameter="{x:Bind}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <TextBox PlaceholderText="New collection"
                                                 Text="{x:Bind ViewModel.ManualCollectionNameDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button Grid.Column="1"
                                                Content="Add"
                                                Command="{x:Bind ViewModel.AddSelectedToNewCollectionCommand}" />
                                    </Grid>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Grid>

                <ScrollViewer Grid.Row="2"
                              AutomationProperties.AutomationId="VideoLibrarySeriesShelf"
                              Visibility="{x:Bind ViewModel.IsSeriesBrowseView, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
                    <ItemsControl Margin="20,0,28,28"
                                  ItemsSource="{x:Bind ViewModel.SeriesCards, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal" ItemWidth="190" ItemHeight="350" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vmc:VideoSeriesViewModel">
                                <Button Width="176" Padding="0" Margin="0,0,14,18"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalContentAlignment="Stretch"
                                        Background="Transparent" BorderThickness="0"
                                        Command="{Binding ViewModel.SelectSeriesCommand, ElementName=ThisPage}"
                                        CommandParameter="{x:Bind}">
                                    <StackPanel Spacing="8">
                                        <Border Height="264" CornerRadius="8"
                                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                            <Grid>
                                                <Image Source="{x:Bind PosterImage, Mode=OneTime}"
                                                       Stretch="UniformToFill"
                                                       Visibility="{x:Bind HasPoster, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneTime}" />
                                                <FontIcon Glyph="&#xE8D2;" FontSize="44" Opacity="0.35"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          Visibility="{x:Bind HasPoster, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert, Mode=OneTime}" />
                                            </Grid>
                                        </Border>
                                        <TextBlock Text="{x:Bind Title, Mode=OneTime}"
                                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                                   TextTrimming="CharacterEllipsis" MaxLines="2" TextWrapping="Wrap" />
                                        <TextBlock Text="{x:Bind FactsText, Mode=OneTime}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <ScrollViewer Grid.Row="2"
                              AutomationProperties.AutomationId="VideoLibrarySeriesDetails"
                              Visibility="{x:Bind ViewModel.IsSeriesDetailView, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
                    <StackPanel Margin="20,0,28,32" Spacing="18">
                        <Button x:Uid="VideoLibraryBackToSeriesButton" Content="Back to series"
                                HorizontalAlignment="Left" Command="{x:Bind ViewModel.BackToSeriesCommand}" />
                        <Grid MinHeight="240" MaxHeight="360">
                            <Border CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    Visibility="{x:Bind ViewModel.SelectedSeries.HasBackdrop, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
                                <Image Source="{x:Bind ViewModel.SelectedSeries.BackdropImage, Mode=OneWay}"
                                       Stretch="UniformToFill" Opacity="0.42" />
                            </Border>
                            <Grid Padding="20" ColumnDefinitions="Auto,*" ColumnSpacing="22" VerticalAlignment="Center">
                                <Border Width="160" Height="240" CornerRadius="8"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        Visibility="{x:Bind ViewModel.SelectedSeries.HasPoster, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
                                    <Image Source="{x:Bind ViewModel.SelectedSeries.PosterImage, Mode=OneWay}"
                                           Stretch="UniformToFill" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="10" VerticalAlignment="Bottom">
                                    <Image Source="{x:Bind ViewModel.SelectedSeries.LogoImage, Mode=OneWay}"
                                           Height="72" MaxWidth="420" HorizontalAlignment="Left" Stretch="Uniform"
                                           Visibility="{x:Bind ViewModel.SelectedSeries.HasLogo, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />
                                    <TextBlock Text="{x:Bind ViewModel.SelectedSeries.Title, Mode=OneWay}"
                                               Style="{StaticResource TitleTextBlockStyle}" FontSize="28" TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind ViewModel.SelectedSeries.OriginalTitle, Mode=OneWay}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Visibility="{x:Bind ViewModel.SelectedSeries.HasOriginalTitle, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />
                                    <TextBlock Text="{x:Bind ViewModel.SelectedSeries.FactsText, Mode=OneWay}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock Text="{x:Bind ViewModel.SelectedSeries.OfficialRating, Mode=OneWay}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   Visibility="{x:Bind ViewModel.SelectedSeries.HasOfficialRating, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />
                                        <TextBlock Text="{x:Bind ViewModel.SelectedSeries.RatingText, Mode=OneWay}"
                                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                   Visibility="{x:Bind ViewModel.SelectedSeries.HasCommunityRating, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />
                                        <TextBlock Text="{x:Bind ViewModel.SelectedSeries.Status, Mode=OneWay}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   Visibility="{x:Bind ViewModel.SelectedSeries.HasStatus, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button x:Uid="VideoLibrarySeriesPlayButton" Content="Play"
                                                Command="{x:Bind ViewModel.OpenVideoCommand}"
                                                CommandParameter="{x:Bind ViewModel.SelectedSeries.PrimaryPlayItem, Mode=OneWay}" />
                                        <Button x:Uid="VideoLibrarySeriesRefreshButton" Content="Refresh metadata"
                                                Command="{x:Bind ViewModel.RefreshSelectedMetadataCommand}" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <TextBlock Text="{x:Bind ViewModel.SelectedSeries.Tagline, Mode=OneWay}"
                                   Style="{StaticResource SubtitleTextBlockStyle}" FontStyle="Italic"
                                   TextWrapping="Wrap"
                                   Visibility="{x:Bind ViewModel.SelectedSeries.HasTagline, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />
                        <TextBlock Text="{x:Bind ViewModel.SelectedSeries.Overview, Mode=OneWay}"
                                   TextWrapping="Wrap" MaxWidth="1100" HorizontalAlignment="Left"
                                   Visibility="{x:Bind ViewModel.SelectedSeries.HasOverview, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />
                        <StackPanel Spacing="6"
                                    Visibility="{x:Bind ViewModel.SelectedSeries.HasGenres, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
                            <TextBlock x:Uid="VideoLibraryDetailsGenresLabel" Text="Genres" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.SelectedSeries.GenresText, Mode=OneWay}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Spacing="6"
                                    Visibility="{x:Bind ViewModel.SelectedSeries.HasTags, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
                            <TextBlock x:Uid="VideoLibraryTagsHeading" Text="Tags" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.SelectedSeries.TagsText, Mode=OneWay}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Spacing="6"
                                    Visibility="{x:Bind ViewModel.SelectedSeries.HasStudios, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
                            <TextBlock x:Uid="VideoLibraryStudiosHeading" Text="Studios" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.SelectedSeries.StudiosText, Mode=OneWay}" TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Spacing="10"
                                    Visibility="{x:Bind ViewModel.SelectedSeries.HasSeasons, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
                            <TextBlock x:Uid="VideoLibrarySeasonsHeading" Text="Seasons" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Hidden">
                                <ItemsControl ItemsSource="{x:Bind ViewModel.SelectedSeries.Seasons, Mode=OneWay}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vmc:VideoSeasonViewModel">
                                            <ToggleButton Width="128"
                                                          Margin="0,0,12,0"
                                                          Padding="0"
                                                          HorizontalContentAlignment="Stretch"
                                                          VerticalContentAlignment="Stretch"
                                                          AutomationProperties.AutomationId="{x:Bind AutomationId, Mode=OneTime}"
                                                          IsChecked="{x:Bind IsSelected, Mode=OneWay}"
                                                          Command="{Binding ViewModel.SelectSeriesSeasonCommand, ElementName=ThisPage}"
                                                          CommandParameter="{x:Bind}">
                                                <StackPanel Spacing="6">
                                                    <Border Height="192" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                                        <Image Source="{x:Bind PosterImage, Mode=OneTime}" Stretch="UniformToFill" />
                                                    </Border>
                                                    <TextBlock Text="{x:Bind Title, Mode=OneTime}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                                    <TextBlock Text="{x:Bind EpisodeCountText, Mode=OneTime}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                            </ToggleButton>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>

                        <StackPanel Spacing="10">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <TextBlock x:Uid="VideoLibraryEpisodesHeading" Text="Episodes" Style="{StaticResource SubtitleTextBlockStyle}" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                    <ProgressRing Width="20"
                                                  Height="20"
                                                  IsActive="{x:Bind ViewModel.IsLoadingSeriesEpisodes, Mode=OneWay}" />
                                    <TextBlock x:Uid="VideoLibraryEpisodesLoadingText"
                                               Text="Loading episodes…"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Visibility="{x:Bind ViewModel.IsLoadingSeriesEpisodes, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />
                                </StackPanel>
                            </Grid>
                            <InfoBar x:Uid="VideoLibraryEpisodesError"
                                     IsClosable="False"
                                     IsOpen="{x:Bind ViewModel.HasSeriesEpisodesError, Mode=OneWay}"
                                     Message="{x:Bind ViewModel.SeriesEpisodesError, Mode=OneWay}"
                                     Severity="Warning" />
                            <ItemsRepeater AutomationProperties.AutomationId="VideoLibraryEpisodeSlots"
                                           ItemsSource="{x:Bind ViewModel.SelectedSeries.SelectedEpisodeSlots, Mode=OneWay}">
                                <ItemsRepeater.Layout>
                                    <UniformGridLayout MinItemWidth="480"
                                                        MinItemHeight="164"
                                                        MinRowSpacing="12"
                                                        MinColumnSpacing="12" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="vmc:VideoEpisodeSlotViewModel">
                                        <Border Padding="10"
                                                CornerRadius="12"
                                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                            <Grid ColumnDefinitions="180,*" ColumnSpacing="14">
                                                <Grid Height="140"
                                                      Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                                    <FontIcon Glyph="&#xE8B4;"
                                                              FontSize="32"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"
                                                              Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                              Visibility="{x:Bind HasArtwork, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}" />
                                                    <Image Source="{x:Bind ArtworkImage, Mode=OneWay}"
                                                           Stretch="UniformToFill"
                                                           Visibility="{x:Bind HasArtwork, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />
                                                </Grid>
                                                <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto" RowSpacing="6">
                                                    <TextBlock Text="{x:Bind NumberText}"
                                                               Style="{StaticResource BodyStrongTextBlockStyle}"
                                                               TextWrapping="WrapWholeWords" />
                                                    <StackPanel Grid.Row="1" Spacing="3">
                                                        <TextBlock Text="{x:Bind Title}"
                                                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                                                   TextWrapping="Wrap"
                                                                   MaxLines="2"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{x:Bind Overview}"
                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                   TextWrapping="Wrap"
                                                                   MaxLines="3"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Visibility="{x:Bind HasOverview, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                                                        <Button x:Uid="VideoLibraryEpisodePlayButton"
                                                                Content="Play"
                                                                Command="{Binding ViewModel.OpenVideoCommand, ElementName=ThisPage}"
                                                                CommandParameter="{x:Bind DownloadedEpisode}"
                                                                Visibility="{x:Bind IsDownloaded, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />
                                                        <Button x:Uid="VideoLibraryEpisodeDownloadButton"
                                                                AutomationProperties.AutomationId="VideoLibraryEpisodeDownloadButton"
                                                                Content="Download"
                                                                Command="{Binding ViewModel.DownloadEpisodeCommand, ElementName=ThisPage}"
                                                                CommandParameter="{x:Bind}"
                                                                IsEnabled="{x:Bind CanDownload, Mode=OneWay}"
                                                                Visibility="{x:Bind IsDownloaded, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert, Mode=OneWay}" />
                                                        <TextBlock Text="{x:Bind StatusText, Mode=OneWay}"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>

                        <StackPanel Spacing="6"
                                    Visibility="{x:Bind ViewModel.SelectedSeries.HasPeople, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
                            <TextBlock x:Uid="VideoLibraryDetailsCastLabel" Text="Cast" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Hidden">
                                <ItemsControl ItemsSource="{x:Bind ViewModel.SelectedSeries.People, Mode=OneWay}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vmc:VideoPersonViewModel">
                                            <Border Width="150" MinHeight="248" Padding="0" Margin="0,0,14,0"
                                                    CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                                <StackPanel Spacing="7">
                                                    <Grid Height="184">
                                                        <FontIcon Glyph="&#xE77B;" FontSize="42"
                                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        <Image Source="{x:Bind Image, Mode=OneTime}" Stretch="UniformToFill" />
                                                    </Grid>
                                                    <StackPanel Padding="10,0,10,10" Spacing="4">
                                                    <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}"
                                                               TextWrapping="Wrap" MaxLines="2" />
                                                    <TextBlock Text="{x:Bind Role}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                               TextWrapping="Wrap" MaxLines="2" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                        <StackPanel Spacing="6"
                                    Visibility="{x:Bind ViewModel.SelectedSeries.HasActorsOnly, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
                            <TextBlock x:Uid="VideoLibraryDetailsCastLabel" Text="Cast" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.SelectedSeries.ActorsText, Mode=OneWay}" TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Spacing="10"
                                    Visibility="{x:Bind ViewModel.SelectedSeries.HasSpecialFeatures, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
                            <TextBlock x:Uid="VideoLibrarySpecialFeaturesHeading" Text="Special features" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Hidden">
                                <ItemsControl ItemsSource="{x:Bind ViewModel.SelectedSeries.SpecialFeatures, Mode=OneWay}"
                                              ItemTemplate="{StaticResource VideoPosterItemTemplate}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>

                        <StackPanel Spacing="10"
                                    Visibility="{x:Bind ViewModel.SelectedSeries.HasRelatedItems, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
                            <TextBlock x:Uid="VideoLibraryMoreLikeThisHeading" Text="More like this" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <ItemsControl ItemsSource="{x:Bind ViewModel.SelectedSeries.RelatedItems, Mode=OneWay}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" ItemWidth="190" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vmc:VideoRelatedItemViewModel">
                                        <Border Width="176" MinHeight="326" Padding="0" Margin="0,0,14,14"
                                                CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                            <StackPanel Spacing="5">
                                                <Grid Height="264">
                                                    <FontIcon Glyph="&#xE7FC;" FontSize="42"
                                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    <Image Source="{x:Bind Image, Mode=OneTime}" Stretch="UniformToFill" />
                                                </Grid>
                                                <StackPanel Padding="10,2,10,10" Spacing="4">
                                                <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyStrongTextBlockStyle}"
                                                           TextWrapping="Wrap" MaxLines="3" />
                                                <TextBlock Text="{x:Bind OriginalTitle}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel Spacing="6"
                                    Visibility="{x:Bind ViewModel.SelectedSeries.HasProviderSources, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
                            <TextBlock x:Uid="VideoLibraryDetailsAttributionLabel" Text="Metadata sources"
                                       Style="{StaticResource SubtitleTextBlockStyle}" />
                            <HyperlinkButton Content="{x:Bind ViewModel.SelectedSeries.ProviderAttributionText, Mode=OneWay}"
                                             NavigateUri="{x:Bind ViewModel.SelectedSeries.PrimaryProviderSourceUri, Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer Grid.Row="2"
                              AutomationProperties.AutomationId="VideoLibraryHomePage"
                              Visibility="{x:Bind ViewModel.IsHomeView, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
                    <StackPanel x:Name="VideoLibraryHomeSections"
                                AutomationProperties.AutomationId="VideoLibraryHomeSections"
                                Margin="20,0,28,28"
                                Spacing="22">
                        <StackPanel Spacing="10">
                            <TextBlock x:Uid="VideoLibraryHomeMyMediaHeading"
                                       Text="My media"
                                       Style="{StaticResource SubtitleTextBlockStyle}" />
                            <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Hidden">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Button Width="250" Command="{x:Bind ViewModel.SelectLibraryViewCommand}"
                                        CommandParameter="Movies" HorizontalContentAlignment="Stretch" Padding="16">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                        <FontIcon Glyph="&#xE8B2;" FontSize="26" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock x:Uid="VideoLibraryHomeMoviesTile" Text="Movies" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                            <TextBlock Text="{x:Bind ViewModel.HomeMoviesCountText, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                                <Button Width="250" Command="{x:Bind ViewModel.SelectLibraryViewCommand}"
                                        CommandParameter="Series" HorizontalContentAlignment="Stretch" Padding="16">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                        <FontIcon Glyph="&#xE8D2;" FontSize="26" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock x:Uid="VideoLibraryHomeSeriesTile" Text="Series" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                            <TextBlock Text="{x:Bind ViewModel.HomeSeriesCountText, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                                <Button Width="250" Command="{x:Bind ViewModel.SelectLibraryViewCommand}"
                                        CommandParameter="Anime" HorizontalContentAlignment="Stretch" Padding="16">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                        <FontIcon Glyph="&#xE7FC;" FontSize="26" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock x:Uid="VideoLibraryHomeAnimeTile" Text="Anime" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                            <TextBlock Text="{x:Bind ViewModel.HomeAnimeCountText, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                                <Button Width="250" Command="{x:Bind ViewModel.SelectLibraryViewCommand}"
                                        CommandParameter="Collections" HorizontalContentAlignment="Stretch" Padding="16">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                        <FontIcon Glyph="&#xE8F1;" FontSize="26" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock x:Uid="VideoLibraryHomeCollectionsTile" Text="Collections" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                            <TextBlock Text="{x:Bind ViewModel.HomeCollectionsCountText, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </StackPanel>
                            </ScrollViewer>
                        </StackPanel>

                        <StackPanel Spacing="8"
                                    Visibility="{x:Bind ViewModel.HasHomeContinueWatching, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
                            <TextBlock x:Uid="VideoLibraryHomeContinueWatchingHeading"
                                       Text="Continue watching" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Hidden">
                                <ItemsControl ItemsSource="{x:Bind ViewModel.HomeContinueWatching, Mode=OneWay}"
                                              ItemTemplate="{StaticResource VideoPosterItemTemplate}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                        <StackPanel Spacing="8"
                                    Visibility="{x:Bind ViewModel.HasHomeNextEpisodes, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
                            <TextBlock x:Uid="VideoLibraryHomeNextEpisodeHeading"
                                       Text="Next up" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Hidden">
                                <ItemsControl ItemsSource="{x:Bind ViewModel.HomeNextEpisodes, Mode=OneWay}"
                                              ItemTemplate="{StaticResource VideoPosterItemTemplate}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                        <StackPanel Spacing="8"
                                    Visibility="{x:Bind ViewModel.HasHomeRecentlyAdded, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
                            <TextBlock x:Uid="VideoLibraryHomeRecentlyAddedHeading"
                                       Text="Recently added media" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Hidden">
                                <ItemsControl ItemsSource="{x:Bind ViewModel.HomeRecentlyAdded, Mode=OneWay}"
                                              ItemTemplate="{StaticResource VideoPosterItemTemplate}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer Grid.Row="2"
                              AutomationProperties.AutomationId="VideoLibrarySourcesPage"
                              Visibility="{x:Bind ViewModel.IsSourcesView, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
                    <StackPanel Margin="20,0,28,28" Spacing="16">
                        <InfoBar x:Uid="VideoLibrarySourcesPrivacyInfo"
                                 Title="Online metadata"
                                 Message="Online scraping runs only after privacy consent. Local scanning and NFO discovery remain available."
                                 IsClosable="False"
                                 IsOpen="True"
                                 Severity="Informational" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.SourceSummaries, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="pages:VideoLibrarySourceSummary">
                                    <Border Margin="0,0,0,12"
                                            Padding="14,12"
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8">
                                        <StackPanel Spacing="12">
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                                <FontIcon Glyph="&#xE8B7;" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1" Spacing="3">
                                                    <TextBlock Text="{x:Bind Source.Name, Mode=OneTime}"
                                                               Style="{StaticResource SubtitleTextBlockStyle}" />
                                                    <TextBlock Text="{x:Bind Source.FolderPath, Mode=OneTime}"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    <TextBlock Text="{x:Bind ScrapeSummaryText, Mode=OneWay}"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                                <CommandBar Grid.Column="2"
                                                            DefaultLabelPosition="Collapsed"
                                                            IsOpen="True"
                                                            OverflowButtonVisibility="Collapsed">
                                                    <AppBarButton x:Uid="VideoLibraryRefreshSourceButton"
                                                                  Label="Scan changes"
                                                                  Command="{Binding ViewModel.RefreshSourceCommand, ElementName=ThisPage}"
                                                                  CommandParameter="{x:Bind}">
                                                        <AppBarButton.Icon><FontIcon Glyph="&#xE72C;" /></AppBarButton.Icon>
                                                    </AppBarButton>
                                                    <AppBarButton x:Uid="VideoLibraryFullScanSourceButton"
                                                                  Label="Full scan"
                                                                  Command="{Binding ViewModel.FullScanSourceCommand, ElementName=ThisPage}"
                                                                  CommandParameter="{x:Bind}">
                                                        <AppBarButton.Icon><FontIcon Glyph="&#xE895;" /></AppBarButton.Icon>
                                                    </AppBarButton>
                                                    <AppBarButton x:Uid="VideoLibraryScrapeSourceButton"
                                                                  Label="Scrape metadata"
                                                                  Command="{Binding ViewModel.RefreshSourceMetadataCommand, ElementName=ThisPage}"
                                                                  CommandParameter="{x:Bind}">
                                                        <AppBarButton.Icon><FontIcon Glyph="&#xE774;" /></AppBarButton.Icon>
                                                    </AppBarButton>
                                                    <AppBarButton x:Uid="VideoLibraryCancelScrapeSourceButton"
                                                                  Label="Cancel scraping"
                                                                  Visibility="{x:Bind IsMetadataProgressVisible, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}"
                                                                  Command="{Binding ViewModel.CancelSourceMetadataCommand, ElementName=ThisPage}"
                                                                  CommandParameter="{x:Bind}">
                                                        <AppBarButton.Icon><FontIcon Glyph="&#xE711;" /></AppBarButton.Icon>
                                                    </AppBarButton>
                                                    <AppBarButton x:Uid="VideoLibrarySourceSettingsButton"
                                                                  Label="Settings"
                                                                  Command="{Binding ViewModel.ToggleSourceSettingsCommand, ElementName=ThisPage}"
                                                                  CommandParameter="{x:Bind}">
                                                        <AppBarButton.Icon><FontIcon Glyph="&#xE713;" /></AppBarButton.Icon>
                                                    </AppBarButton>
                                                    <AppBarButton x:Uid="VideoLibraryRevealSourceButton"
                                                                  Label="Open folder"
                                                                  Command="{Binding ViewModel.RevealSourceCommand, ElementName=ThisPage}"
                                                                  CommandParameter="{x:Bind}">
                                                        <AppBarButton.Icon><FontIcon Glyph="&#xE8B7;" /></AppBarButton.Icon>
                                                    </AppBarButton>
                                                    <AppBarButton x:Uid="VideoLibraryRemoveSourceButton"
                                                                  Label="Remove source"
                                                                  Command="{Binding ViewModel.RemoveSourceCommand, ElementName=ThisPage}"
                                                                  CommandParameter="{x:Bind}">
                                                        <AppBarButton.Icon><FontIcon Glyph="&#xE74D;" /></AppBarButton.Icon>
                                                    </AppBarButton>
                                                </CommandBar>
                                            </Grid>

                                            <TextBlock Text="{x:Bind Source.LastError, Mode=OneWay}"
                                                       Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                       TextWrapping="Wrap"
                                                       Visibility="{x:Bind HasError, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />

                                            <StackPanel Spacing="5"
                                                        Visibility="{x:Bind IsScanProgressVisible, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
                                                <TextBlock Text="{x:Bind ScanProgressText, Mode=OneWay}"
                                                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                <ProgressBar Height="4" Minimum="0" Maximum="100"
                                                             IsIndeterminate="{x:Bind IsScanIndeterminate, Mode=OneWay}"
                                                             Value="{x:Bind ScanProgressValue, Mode=OneWay}" />
                                                <TextBlock Text="{x:Bind CurrentItemText, Mode=OneWay}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>

                                            <StackPanel Spacing="5"
                                                        Visibility="{x:Bind IsMetadataProgressVisible, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
                                                <TextBlock Text="{x:Bind MetadataProgressText, Mode=OneWay}"
                                                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                <ProgressBar Height="4" Minimum="0" Maximum="100"
                                                             IsIndeterminate="{x:Bind IsMetadataIndeterminate, Mode=OneWay}"
                                                             Value="{x:Bind MetadataProgressValue, Mode=OneWay}" />
                                                <TextBlock Text="{x:Bind MetadataErrorText, Mode=OneWay}"
                                                           TextWrapping="Wrap"
                                                           Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                           Visibility="{x:Bind HasMetadataError, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />
                                            </StackPanel>

                                            <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8"
                                                  Visibility="{x:Bind IsSourceSettingsExpanded, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
                                                <StackPanel Spacing="3">
                                                    <TextBlock Text="{x:Bind StatusText, Mode=OneWay}"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    <TextBlock Text="{x:Bind LastScannedText, Mode=OneWay}"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                                <ComboBox x:Uid="VideoLibrarySourceMediaTypeBox"
                                                          Grid.Row="1"
                                                          Header="Media type"
                                                          HorizontalAlignment="Stretch"
                                                          ItemsSource="{Binding ViewModel.SourceMediaTypeOptions, ElementName=ThisPage}"
                                                          DisplayMemberPath="DisplayName"
                                                          SelectedIndex="{x:Bind MediaTypeSelectedIndex, Mode=TwoWay}" />
                                                <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="8">
                                                    <TextBox x:Uid="VideoLibrarySourceLanguageBox" Header="Language"
                                                             Text="{x:Bind Source.Language, Mode=TwoWay}" />
                                                    <TextBox Grid.Column="1" x:Uid="VideoLibrarySourceRegionBox" Header="Region"
                                                             Text="{x:Bind Source.Region, Mode=TwoWay}" />
                                                </Grid>
                                                <TextBox Grid.Row="3"
                                                         x:Uid="VideoLibrarySourceProviderOrderBox"
                                                         Header="Provider order"
                                                         PlaceholderText="local, tmdb, tvmaze"
                                                         Text="{x:Bind ProviderOrderDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            </Grid>

                                            <CommandBar DefaultLabelPosition="Right" IsOpen="True"
                                                        Visibility="{x:Bind IsSourceSettingsExpanded, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
                                                <AppBarButton x:Uid="VideoLibrarySaveSourceSettingsButton"
                                                              Label="Save"
                                                              Command="{Binding ViewModel.SaveSourceSettingsCommand, ElementName=ThisPage}"
                                                              CommandParameter="{x:Bind}">
                                                    <AppBarButton.Icon><FontIcon Glyph="&#xE74E;" /></AppBarButton.Icon>
                                                </AppBarButton>
                                                <CommandBar.SecondaryCommands>
                                                    <AppBarButton x:Uid="VideoLibraryPauseSourceScanButton"
                                                                  Label="Pause scan"
                                                                  Command="{Binding ViewModel.PauseSourceScanCommand, ElementName=ThisPage}"
                                                                  CommandParameter="{x:Bind}" />
                                                    <AppBarButton x:Uid="VideoLibraryResumeSourceScanButton"
                                                                  Label="Resume scan"
                                                                  Command="{Binding ViewModel.ResumeSourceScanCommand, ElementName=ThisPage}"
                                                                  CommandParameter="{x:Bind}" />
                                                    <AppBarButton x:Uid="VideoLibraryCancelSourceScanButton"
                                                                  Label="Cancel scan"
                                                                  Command="{Binding ViewModel.CancelSourceScanCommand, ElementName=ThisPage}"
                                                                  CommandParameter="{x:Bind}" />
                                                    <AppBarButton x:Uid="VideoLibraryRevealSourceButton"
                                                                  Label="Open folder"
                                                                  Command="{Binding ViewModel.RevealSourceCommand, ElementName=ThisPage}"
                                                                  CommandParameter="{x:Bind}" />
                                                </CommandBar.SecondaryCommands>
                                            </CommandBar>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </NavigationView>

        <ContentDialog x:Name="CreateSmartCollectionDialog"
                       Title="{x:Bind ViewModel.SmartCollectionDialogTitle, Mode=OneWay}"
                       FullSizeDesired="False"
                       DefaultButton="None">
            <StackPanel Spacing="16"
                        MinWidth="440">
                <TextBox x:Uid="VideoLibrarySmartCollectionName"
                         Header="Name"
                         PlaceholderText="Smart collection name"
                         Text="{Binding SmartCollectionNameDraft, Mode=TwoWay}" />
                <TextBlock Text="All rules must match" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <ItemsControl ItemsSource="{x:Bind ViewModel.SmartRuleDrafts, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="pages:VideoSmartRuleDraft">
                            <Grid ColumnDefinitions="132,112,*,Auto"
                                  ColumnSpacing="8"
                                  Margin="0,0,0,8">
                                <ComboBox DisplayMemberPath="DisplayName"
                                          ItemsSource="{Binding ViewModel.AvailableSmartRuleFields, ElementName=ThisPage}"
                                          SelectedValue="{x:Bind Field, Mode=TwoWay}"
                                          SelectedValuePath="Value"
                                          SelectionChanged="SmartRuleEditor_SelectionChanged" />
                                <ComboBox Grid.Column="1"
                                          DisplayMemberPath="DisplayName"
                                          ItemsSource="{Binding ViewModel.AvailableSmartRuleMatches, ElementName=ThisPage}"
                                          SelectedValue="{x:Bind Match, Mode=TwoWay}"
                                          SelectedValuePath="Value"
                                          SelectionChanged="SmartRuleEditor_SelectionChanged" />
                                <TextBox Grid.Column="2"
                                         PlaceholderText="Value"
                                         Text="{x:Bind Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         TextChanged="SmartRuleEditor_TextChanged" />
                                <Button Grid.Column="3"
                                        Command="{Binding ViewModel.RemoveSmartRuleCommand, ElementName=ThisPage}"
                                        CommandParameter="{x:Bind}">
                                    <SymbolIcon Symbol="Remove" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="Add rule"
                        HorizontalAlignment="Left"
                        Command="{x:Bind ViewModel.AddSmartRuleCommand}" />
                <StackPanel Spacing="8">
                    <TextBlock x:Uid="VideoLibraryPreviewMatches"
                               Text="Preview matches"
                               Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <ItemsControl ItemsSource="{Binding SmartCollectionPreviewRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vmc:VideoItemViewModel">
                                <TextBlock Text="{Binding Video.Title}"
                                           TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Spacing="8">
                    <Button x:Uid="VideoLibraryCreateSmartCollectionSecondaryButton"
                            Content="Cancel"
                            Click="CreateSmartCollectionSecondaryButton_Click" />
                    <Button x:Uid="VideoLibraryCreateSmartCollectionPrimaryButton"
                            Content="Create"
                            Command="{x:Bind ViewModel.CreateSmartCollectionCommand}"
                            Click="CreateSmartCollectionPrimaryButton_Click" />
                </StackPanel>
            </StackPanel>
        </ContentDialog>

    </Grid>
</Page>
