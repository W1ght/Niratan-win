<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="Niratan.Views.Pages.DiscoverPage"
      x:Name="ThisPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:components="using:Niratan.ViewModels.Components"
      xmlns:converters="using:Niratan.Helpers.UI.Converters"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">
    <Page.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Page.Resources>

    <Grid Padding="0,8,24,24" RowDefinitions="Auto,*">
        <CommandBar Grid.Row="0"
                    Margin="12,6,0,0"
                    DefaultLabelPosition="Right">
            <CommandBar.Content>
                <TextBlock x:Uid="DiscoverPageTitleText"
                           Margin="4,0,0,0"
                           Style="{StaticResource TitleTextBlockStyle}"
                           Text="Video"
                           Visibility="{x:Bind IsEmbedded, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert, Mode=OneWay}" />
            </CommandBar.Content>
            <AppBarButton x:Uid="DiscoverRefreshButton"
                          AutomationProperties.AutomationId="DiscoverRefreshButton"
                          Command="{x:Bind ViewModel.RefreshCommand}"
                          Label="Refresh">
                <AppBarButton.Icon><SymbolIcon Symbol="Refresh" /></AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton x:Uid="DiscoverOpenDownloadsButton"
                          AutomationProperties.AutomationId="DiscoverOpenDownloadsButton"
                          Command="{x:Bind ViewModel.OpenDownloadTasksCommand}"
                          Label="Download tasks">
                <AppBarButton.Icon><SymbolIcon Symbol="Download" /></AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton x:Uid="DiscoverOpenSubscriptionsButton"
                          AutomationProperties.AutomationId="DiscoverOpenSubscriptionsButton"
                          Command="{x:Bind ViewModel.OpenSubscriptionsCommand}"
                          Label="Subscriptions">
                <AppBarButton.Icon><SymbolIcon Symbol="Favorite" /></AppBarButton.Icon>
            </AppBarButton>
        </CommandBar>

        <Grid Grid.Row="1" Margin="20,12,0,0" RowDefinitions="Auto,*">
            <StackPanel x:Name="VideoSearchToolbar"
                        Grid.Row="0"
                        Spacing="10">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBox x:Name="VideoSearchBox"
                             x:Uid="DiscoverVideoSearchBox"
                             AutomationProperties.AutomationId="DiscoverVideoSearchBox"
                             Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             KeyDown="VideoSearchBox_KeyDown" />
                    <Button Grid.Column="1"
                            x:Uid="DiscoverVideoSearchButton"
                            AutomationProperties.AutomationId="DiscoverVideoSearchButton"
                            Command="{x:Bind ViewModel.SearchVideosCommand}"
                            Content="Search"
                            Style="{StaticResource AccentButtonStyle}" />
                </Grid>

                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox x:Uid="DiscoverYearBox"
                                 AutomationProperties.AutomationId="DiscoverYearBox"
                                 Header="Year"
                                 PlaceholderText="2026"
                                 Text="{x:Bind ViewModel.YearText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Width="100" />
                        <TextBox x:Uid="DiscoverGenreBox"
                                 AutomationProperties.AutomationId="DiscoverGenreBox"
                                 Header="Genre ID"
                                 PlaceholderText="16"
                                 Text="{x:Bind ViewModel.GenreId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Width="110" />
                        <ComboBox x:Uid="DiscoverSortBox"
                                  AutomationProperties.AutomationId="DiscoverSortBox"
                                  DisplayMemberPath="DisplayName"
                                  Header="Sort"
                                  ItemsSource="{x:Bind ViewModel.SortOptions, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.SelectedSortOption, Mode=TwoWay}"
                                  Width="210" />
                        <Button x:Uid="DiscoverLoadButton"
                                AutomationProperties.AutomationId="DiscoverLoadButton"
                                Command="{x:Bind ViewModel.ApplyFiltersCommand}"
                                Content="Apply"
                                Style="{StaticResource AccentButtonStyle}"
                                VerticalAlignment="Bottom" />
                    </StackPanel>
                </ScrollViewer>
            </StackPanel>

            <ScrollViewer x:Name="VideoContentScrollViewer"
                          Grid.Row="1"
                          Margin="0,12,0,0"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          ViewChanged="VideoContentScrollViewer_ViewChanged">
                <StackPanel Spacing="14">
                    <InfoBar IsClosable="False"
                             IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                             Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                             Severity="Warning">
                        <InfoBar.ActionButton>
                            <Button x:Uid="DiscoverOpenSettingsButton"
                                    AutomationProperties.AutomationId="DiscoverOpenSettingsButton"
                                    Command="{x:Bind ViewModel.OpenVideoSettingsCommand}"
                                    Content="Open video settings" />
                        </InfoBar.ActionButton>
                    </InfoBar>

                    <InfoBar AutomationProperties.AutomationId="DiscoverProviderWarning"
                             IsClosable="False"
                             IsOpen="{x:Bind ViewModel.HasProviderWarning, Mode=OneWay}"
                             Message="{x:Bind ViewModel.ProviderWarning, Mode=OneWay}"
                             Severity="Warning" />

                    <StackPanel Spacing="10"
                                Visibility="{x:Bind ViewModel.IsSearchMode, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert, Mode=OneWay}">
                        <TextBlock x:Uid="DiscoverRecommendationHeading"
                                   Style="{StaticResource SubtitleTextBlockStyle}"
                                   Text="Recommendations" />
                        <ProgressRing Width="24"
                                      Height="24"
                                      IsActive="{x:Bind ViewModel.IsLoadingRecommendations, Mode=OneWay}"
                                      HorizontalAlignment="Left" />
                        <ItemsRepeater AutomationProperties.AutomationId="DiscoverRecommendationSections"
                                       ItemsSource="{x:Bind ViewModel.RecommendationSections, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="22" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="components:VideoDiscoverySectionViewModel">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="{x:Bind Title}"
                                                   Style="{StaticResource SubtitleTextBlockStyle}" />
                                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                                      VerticalScrollBarVisibility="Disabled"
                                                      Loaded="HorizontalVideoList_Loaded">
                                            <ItemsRepeater ItemsSource="{x:Bind Items}">
                                                <ItemsRepeater.Layout>
                                                    <StackLayout Orientation="Horizontal" Spacing="14" />
                                                </ItemsRepeater.Layout>
                                                <ItemsRepeater.ItemTemplate>
                                                    <DataTemplate x:DataType="components:VideoDiscoveryCardViewModel">
                                                        <Button Style="{StaticResource VideoDiscoveryCardButtonStyle}"
                                                                Tag="{x:Bind NavigationTarget}"
                                                                Click="DiscoveryCard_Click"
                                                                AutomationProperties.AutomationId="DiscoverRecommendationCardButton">
                                                            <StackPanel Width="{StaticResource VideoDiscoveryCardWidth}" Spacing="5">
                                                                <Grid Height="{StaticResource VideoDiscoveryArtworkHeight}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                                                    <FontIcon Glyph="&#xE8B4;"
                                                                              FontSize="42"
                                                                              HorizontalAlignment="Center"
                                                                              VerticalAlignment="Center"
                                                                              Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                                    <Image Source="{x:Bind PosterImage}"
                                                                           Style="{StaticResource VideoPosterArtworkImageStyle}" />
                                                                </Grid>
                                                                <TextBlock Text="{x:Bind Title}"
                                                                           Style="{StaticResource VideoCardTitleTextBlockStyle}" />
                                                                <TextBlock Text="{x:Bind FactsText}"
                                                                           Style="{StaticResource VideoCardMetadataTextBlockStyle}" />
                                                                <TextBlock Text="{x:Bind SourceText}"
                                                                           Style="{StaticResource VideoCardAccentMetadataTextBlockStyle}" />
                                                            </StackPanel>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsRepeater.ItemTemplate>
                                            </ItemsRepeater>
                                        </ScrollViewer>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>

                    <TextBlock AutomationProperties.AutomationId="DiscoverSearchResultsHeading"
                               Style="{StaticResource SubtitleTextBlockStyle}"
                               Text="{x:Bind ViewModel.ResultsHeading, Mode=OneWay}"
                               Visibility="{x:Bind ViewModel.IsSearchMode, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />
                    <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ProgressRing Width="24"
                                  Height="24"
                                  IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                                  HorizontalAlignment="Left" />
                    <ItemsRepeater AutomationProperties.AutomationId="DiscoverExploreResults"
                                   ItemsSource="{x:Bind ViewModel.ExploreItems, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout MinItemWidth="180"
                                                MinItemHeight="{StaticResource VideoDiscoveryCardHeight}"
                                                MinRowSpacing="18"
                                                MinColumnSpacing="14" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="components:VideoDiscoveryCardViewModel">
                                <Button Style="{StaticResource VideoDiscoveryCardButtonStyle}"
                                        Tag="{x:Bind NavigationTarget}"
                                        Click="DiscoveryCard_Click"
                                        HorizontalAlignment="Left"
                                        AutomationProperties.AutomationId="DiscoverCardButton">
                                    <StackPanel Width="{StaticResource VideoDiscoveryCardWidth}" Spacing="5">
                                        <Grid Height="{StaticResource VideoDiscoveryArtworkHeight}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                            <FontIcon Glyph="&#xE8B4;"
                                                      FontSize="42"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                            <Image Source="{x:Bind PosterImage}"
                                                   Style="{StaticResource VideoPosterArtworkImageStyle}" />
                                        </Grid>
                                        <TextBlock Text="{x:Bind Title}"
                                                   Style="{StaticResource VideoCardTitleTextBlockStyle}" />
                                        <TextBlock Text="{x:Bind FactsText}"
                                                   Style="{StaticResource VideoCardMetadataTextBlockStyle}" />
                                        <TextBlock Text="{x:Bind SourceText}"
                                                   Style="{StaticResource VideoCardAccentMetadataTextBlockStyle}" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                    <ProgressRing Width="24"
                                  Height="24"
                                  IsActive="{x:Bind ViewModel.IsLoadingMore, Mode=OneWay}"
                                  HorizontalAlignment="Center" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
