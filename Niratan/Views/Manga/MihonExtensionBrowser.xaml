<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="Niratan.Views.Manga.MihonExtensionBrowser"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:components="using:Niratan.ViewModels.Components"
             xmlns:converters="using:Niratan.Helpers.UI.Converters">
    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <CollectionViewSource x:Key="GroupedMihonRepositorySources"
                              IsSourceGrouped="True"
                              Source="{Binding MihonRepositorySourceGroups}" />

        <DataTemplate x:Key="MihonRepositorySourceTemplate"
                      x:DataType="components:MihonRepositorySourceItemViewModel">
            <Grid MinHeight="64"
                  Padding="12,6"
                  ColumnDefinitions="Auto,*,Auto,Auto"
                  ColumnSpacing="14"
                  DataContextChanged="MihonRepositorySourceRow_DataContextChanged"
                  Loaded="MihonRepositorySourceRow_Loaded">
                <Border Width="44"
                        Height="44"
                        VerticalAlignment="Center"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="6">
                    <Grid>
                        <Image Margin="4"
                               ImageFailed="MihonRepositorySourceIcon_ImageFailed"
                               Source="{x:Bind IconImage, Mode=OneWay}"
                               Stretch="Uniform"
                               Visibility="{x:Bind HasIcon, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />
                        <FontIcon FontSize="22"
                                  Glyph="&#xE74C;"
                                  Visibility="{x:Bind NeedsIconFallback, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="2">
                    <TextBlock FontSize="16"
                               Text="{x:Bind Name, Mode=OneTime}"
                               TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal"
                                Spacing="8">
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="{x:Bind Metadata, Mode=OneTime}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Text="{x:Bind NsfwBadgeLabel, Mode=OneTime}"
                                   Visibility="{x:Bind IsNsfw, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneTime}" />
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="2"
                        Width="42"
                        Height="42"
                        Padding="0"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="{x:Bind AutomationId, Mode=OneTime}"
                        Command="{x:Bind InstallCommand}"
                        ToolTipService.ToolTip="{x:Bind InstallActionLabel, Mode=OneTime}">
                    <FontIcon FontSize="18"
                              Glyph="&#xE896;" />
                </Button>
                <Button Grid.Column="3"
                        Width="42"
                        Height="42"
                        Padding="0"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="{x:Bind RemoveAutomationId, Mode=OneTime}"
                        Command="{x:Bind RemoveCommand}"
                        IsEnabled="{x:Bind CanRemove, Mode=OneTime}"
                        ToolTipService.ToolTip="{x:Bind RemoveActionLabel, Mode=OneTime}"
                        >
                    <SymbolIcon Symbol="Delete" />
                </Button>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,Auto,*">
        <Grid Margin="20,0,36,10"
              ColumnDefinitions="*,200,Auto"
              ColumnSpacing="10">
            <TextBox x:Uid="MihonRepositorySearchField"
                     AutomationProperties.AutomationId="MihonRepositorySearchTextBox"
                     PlaceholderText="Search extensions"
                     Text="{Binding MihonRepositorySearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <ComboBox x:Uid="MihonRepositoryLanguageFilter"
                      Grid.Column="1"
                      AutomationProperties.AutomationId="MihonRepositoryLanguageComboBox"
                      DisplayMemberPath="Label"
                      ItemsSource="{Binding MihonRepositoryLanguageOptions}"
                      SelectedItem="{Binding SelectedMihonRepositoryLanguage, Mode=TwoWay}" />
            <Button x:Uid="MihonExtensionBrowserRefreshIconButton"
                    Grid.Column="2"
                    Width="42"
                    Height="42"
                    Padding="0"
                    AutomationProperties.AutomationId="MihonExtensionBrowserRefreshButton"
                    Command="{Binding RefreshMihonRepositoryCommand}"
                    ToolTipService.ToolTip="Refresh repository">
                <SymbolIcon Symbol="Refresh" />
            </Button>
        </Grid>

        <Grid Grid.Row="1"
              Margin="24,0,40,8"
              ColumnDefinitions="*">
            <TextBlock x:Uid="MihonRepositoryResultsText"
                       VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="{Binding MihonRepositoryResultsSummary}" />
        </Grid>

        <ListView Grid.Row="2"
                  AutomationProperties.AutomationId="MihonRepositorySourcesList"
                  ItemTemplate="{StaticResource MihonRepositorySourceTemplate}"
                  ItemsSource="{Binding Source={StaticResource GroupedMihonRepositorySources}}"
                  SelectionMode="None"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollMode="Enabled">
            <ListView.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate x:DataType="components:MihonRepositorySourceGroup">
                            <TextBlock Margin="20,14,36,4"
                                       FontWeight="SemiBold"
                                       Text="{x:Bind Label, Mode=OneTime}" />
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListView.GroupStyle>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="CornerRadius" Value="0" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="Padding" Value="0" />
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>
    </Grid>
</UserControl>
