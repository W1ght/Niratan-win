<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="Niratan.Views.Manga.MangaPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="PageRoot"
          Background="Transparent"
          PointerCaptureLost="PageRoot_PointerCaptureLost"
          PointerExited="PageRoot_PointerExited"
          PointerMoved="PageRoot_PointerMoved"
          PointerPressed="PageRoot_PointerPressed"
          PointerReleased="PageRoot_PointerReleased"
          SizeChanged="PageRoot_SizeChanged">
        <Image x:Name="PageImage"
               HorizontalAlignment="Stretch"
               VerticalAlignment="Stretch"
               ImageOpened="PageImage_ImageOpened"
               Stretch="Uniform" />
        <Canvas x:Name="ActiveTextCanvas"
                IsHitTestVisible="False" />
        <Canvas x:Name="HitCanvas"
                Background="Transparent" />
        <ProgressRing x:Name="LoadingIndicator"
                      Width="40"
                      Height="40"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center" />
        <TextBlock x:Name="ErrorText"
                   MaxWidth="500"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Foreground="#FFFF7777"
                   TextAlignment="Center"
                   TextWrapping="Wrap" />
    </Grid>
</UserControl>
