<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="Niratan.Views.Manga.MangaSourceSettingsContent"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="using:Niratan.Helpers.UI.Converters">
    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto"
                  VerticalScrollMode="Enabled">
        <StackPanel MaxWidth="960"
                    Padding="32,24,32,40"
                    HorizontalAlignment="Left"
                    Spacing="14">
            <TextBlock x:Uid="BrowseConnectionSettingsTitle"
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       Text="Source settings" />

            <Expander x:Uid="SuwayomiConnectionSettingsExpander"
                      AutomationProperties.AutomationId="SuwayomiConnectionSettingsExpander"
                      Header="Suwayomi Server">
                <StackPanel Padding="0,12,0,4"
                            Spacing="12">
                    <InfoBar x:Uid="MangaSourcesBoundaryInfoBar"
                             IsOpen="True"
                             IsClosable="False"
                             Severity="Informational"
                             Message="Niratan connects to an existing Suwayomi Server. Suwayomi manages Java and Mihon extensions." />
                    <TextBox x:Uid="MangaSourcesServerTextBox"
                             AutomationProperties.AutomationId="MangaSourcesServerTextBox"
                             Header="Server"
                             Text="{Binding ServerUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <Grid ColumnDefinitions="Auto,*,*,Auto"
                          ColumnSpacing="8">
                        <ComboBox x:Uid="MangaSourcesAuthenticationComboBox"
                                  Width="140"
                                  Header="Authentication"
                                  SelectedIndex="{Binding AuthModeIndex, Mode=TwoWay}">
                            <ComboBoxItem x:Uid="MangaSourcesAuthNoneItem" Content="None" />
                            <ComboBoxItem x:Uid="MangaSourcesAuthBasicItem" Content="Basic" />
                            <ComboBoxItem x:Uid="MangaSourcesAuthUiLoginItem" Content="UI login" />
                            <ComboBoxItem x:Uid="MangaSourcesAuthBearerItem" Content="Bearer token" />
                        </ComboBox>
                        <TextBox x:Uid="MangaSourcesUsernameTextBox"
                                 Grid.Column="1"
                                 Header="Username"
                                 Text="{Binding Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <PasswordBox x:Uid="MangaSourcesSecretBox"
                                     Grid.Column="2"
                                     AutomationProperties.AutomationId="MangaSourcesSecretBox"
                                     Header="Password / token"
                                     PasswordChanged="MangaSourcesSecretBox_PasswordChanged" />
                        <Button x:Uid="MangaSourcesConnectButton"
                                Grid.Column="3"
                                VerticalAlignment="Bottom"
                                AutomationProperties.AutomationId="MangaSourcesConnectButton"
                                Command="{Binding ConnectSuwayomiCommand}"
                                Content="Connect"
                                Style="{StaticResource AccentButtonStyle}" />
                    </Grid>
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="{Binding SuwayomiStatusMessage, Mode=OneWay}"
                               TextWrapping="Wrap" />
                    <ProgressBar IsIndeterminate="{Binding IsSuwayomiBusy, Mode=OneWay}"
                                 Visibility="{Binding IsSuwayomiBusy, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />
                </StackPanel>
            </Expander>

            <Expander x:Uid="MihonConnectionSettingsExpander"
                      AutomationProperties.AutomationId="MihonConnectionSettingsExpander"
                      Header="Mihon APK bridge">
                <StackPanel Padding="0,12,0,4"
                            Spacing="12">
                    <InfoBar x:Uid="MihonSourcesBoundaryInfoBar"
                             IsOpen="True"
                             IsClosable="False"
                             Severity="Warning"
                             Message="Mihon APKs execute third-party code in the bundled Java sidecar. The runtime starts automatically; install only trusted extensions and verify Windows Firewall." />
                    <InfoBar x:Uid="MihonBundledRuntimeInfoBar"
                             IsOpen="True"
                             IsClosable="False"
                             Severity="Informational"
                             Message="M-Extension-Server 1.0.4 and its private Java runtime are included with Niratan. No separate download or path configuration is required." />
                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="12">
                        <StackPanel Spacing="2">
                            <TextBlock x:Uid="MihonRepositoriesHeader"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"
                                       Text="Extension repositories" />
                            <TextBlock x:Uid="MihonRepositoriesDescription"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="Extensions from all repositories appear together in the extension browser."
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <Button x:Uid="MihonAddRepositoryButton"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                AutomationProperties.AutomationId="MihonAddRepositoryButton"
                                Command="{Binding AddMihonRepositoryCommand}"
                                Content="Add repository"
                                Style="{StaticResource AccentButtonStyle}" />
                    </Grid>
                    <ListView AutomationProperties.AutomationId="MihonRepositoriesList"
                              ItemsSource="{Binding MihonRepositories, Mode=OneWay}"
                              SelectionMode="None"
                              HorizontalContentAlignment="Stretch">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment"
                                        Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid MinHeight="68"
                                      Padding="12,8"
                                      ColumnDefinitions="Auto,*,Auto,Auto"
                                      ColumnSpacing="12"
                                      AutomationProperties.AutomationId="{Binding AutomationId}">
                                    <Border Width="40"
                                            Height="40"
                                            VerticalAlignment="Center"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            CornerRadius="6">
                                        <FontIcon Glyph="&#xE774;"
                                                  FontSize="18" />
                                    </Border>
                                    <StackPanel Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Spacing="2">
                                        <TextBlock Text="{Binding Name}"
                                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   Text="{Binding IndexUrl}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <Button x:Uid="MihonEditRepositoryButton"
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            AutomationProperties.AutomationId="{Binding EditAutomationId}"
                                            Command="{Binding EditCommand}">
                                        <FontIcon Glyph="&#xE70F;" />
                                    </Button>
                                    <Button x:Uid="MihonRemoveRepositoryButton"
                                            Grid.Column="3"
                                            VerticalAlignment="Center"
                                            AutomationProperties.AutomationId="{Binding RemoveAutomationId}"
                                            Command="{Binding RemoveCommand}">
                                        <FontIcon Glyph="&#xE74D;" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock x:Uid="MihonRepositoryEmptyText"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="No extension repositories have been added."
                               TextWrapping="Wrap"
                               Visibility="{Binding HasNoMihonRepositories, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="{Binding MihonStatusMessage, Mode=OneWay}"
                               TextWrapping="Wrap" />
                    <ProgressBar IsIndeterminate="{Binding IsMihonBusy, Mode=OneWay}"
                                 Visibility="{Binding IsMihonBusy, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />
                </StackPanel>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
