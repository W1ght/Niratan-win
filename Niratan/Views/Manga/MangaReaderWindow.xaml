<?xml version="1.0" encoding="utf-8" ?>
<Window x:Class="Niratan.Views.Manga.MangaReaderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:components="using:Niratan.ViewModels.Pages"
        xmlns:manga="using:Niratan.Views.Manga">
    <Grid x:Name="RootGrid"
          Background="#111111"
          IsTabStop="True"
          KeyDown="RootGrid_KeyDown"
          PointerPressed="RootGrid_PointerPressed">
        <Grid.Resources>
            <DataTemplate x:Key="ContinuousPageTemplate"
                          x:DataType="components:MangaReaderPageItemViewModel">
                <manga:MangaPageView MinHeight="720"
                                     Margin="20,8"
                                     MaxWidth="1400"
                                     HorizontalAlignment="Stretch"
                                     ContextMenuRequested="MangaPageView_ContextMenuRequested"
                                     LookupRequested="MangaPageView_LookupRequested"
                                     PanRequested="MangaPageView_PanRequested"
                                     Page="{x:Bind}" />
            </DataTemplate>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="48" />
        </Grid.RowDefinitions>

        <Grid x:Name="ReaderTitleBar"
              Grid.Row="0"
              Padding="12,0,148,0"
              Background="#CC181818">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal"
                        Spacing="4">
                <Button x:Uid="MangaReaderPreviousButton"
                        AutomationProperties.AutomationId="MangaPreviousPageButton"
                        Command="{x:Bind ViewModel.GoBackwardCommand}"
                        IsEnabled="{x:Bind ViewModel.CanGoBackward, Mode=OneWay}"
                        ToolTipService.ToolTip="Previous">
                    <SymbolIcon Symbol="Back" />
                </Button>
                <Button x:Uid="MangaReaderNextButton"
                        AutomationProperties.AutomationId="MangaNextPageButton"
                        Command="{x:Bind ViewModel.GoForwardCommand}"
                        IsEnabled="{x:Bind ViewModel.CanGoForward, Mode=OneWay}"
                        ToolTipService.ToolTip="Next">
                    <SymbolIcon Symbol="Forward" />
                </Button>
            </StackPanel>
            <TextBlock Grid.Column="1"
                       Margin="16,0"
                       VerticalAlignment="Center"
                       Foreground="White"
                       FontWeight="SemiBold"
                       Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                       TextTrimming="CharacterEllipsis" />
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="4">
                <Button x:Uid="MangaReaderLayoutButton"
                        AutomationProperties.AutomationId="MangaLayoutButton"
                        Content="Layout">
                    <Button.Flyout>
                        <MenuFlyout>
                            <ToggleMenuFlyoutItem x:Name="SinglePageLayoutItem"
                                                  x:Uid="MangaReaderSinglePageMenuItem"
                                                  Tag="SinglePage"
                                                  Text="Single page"
                                                  Click="LayoutMenuItem_Click" />
                            <ToggleMenuFlyoutItem x:Name="DoublePageLayoutItem"
                                                  x:Uid="MangaReaderDoublePageMenuItem"
                                                  Tag="DoublePage"
                                                  Text="Double page"
                                                  Click="LayoutMenuItem_Click" />
                            <ToggleMenuFlyoutItem x:Name="ContinuousLayoutItem"
                                                  x:Uid="MangaReaderContinuousMenuItem"
                                                  Tag="Continuous"
                                                  Text="Continuous"
                                                  Click="LayoutMenuItem_Click" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <Button x:Uid="MangaReaderDirectionButton"
                        AutomationProperties.AutomationId="MangaDirectionButton"
                        Content="Direction">
                    <Button.Flyout>
                        <MenuFlyout>
                            <ToggleMenuFlyoutItem x:Name="RightToLeftDirectionItem"
                                                  x:Uid="MangaReaderRightToLeftMenuItem"
                                                  Tag="RightToLeft"
                                                  Text="Right to left"
                                                  Click="DirectionMenuItem_Click" />
                            <ToggleMenuFlyoutItem x:Name="LeftToRightDirectionItem"
                                                  x:Uid="MangaReaderLeftToRightMenuItem"
                                                  Tag="LeftToRight"
                                                  Text="Left to right"
                                                  Click="DirectionMenuItem_Click" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <Button x:Name="OcrButton"
                        x:Uid="MangaReaderOcrButton"
                        AutomationProperties.AutomationId="MangaGoogleOcrButton"
                        Click="OcrButton_Click"
                        Content="OCR"
                        ToolTipService.ToolTip="Recognize manga text with Google Lens" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <ScrollViewer x:Name="PagedScrollViewer"
                          Background="Black"
                          HorizontalScrollBarVisibility="Auto"
                          HorizontalScrollMode="Enabled"
                          MaxZoomFactor="2"
                          MinZoomFactor="0.5"
                          PointerWheelChanged="PagedScrollViewer_PointerWheelChanged"
                          VerticalScrollBarVisibility="Auto"
                          VerticalScrollMode="Enabled"
                          ZoomMode="Enabled">
                <Grid x:Name="PagedCanvas"
                      MinWidth="{x:Bind PagedScrollViewer.ViewportWidth, Mode=OneWay}"
                      MinHeight="{x:Bind PagedScrollViewer.ViewportHeight, Mode=OneWay}"
                      Background="Black" />
            </ScrollViewer>

            <ScrollViewer x:Name="ContinuousScrollViewer"
                          Background="Black"
                          HorizontalScrollBarVisibility="Auto"
                          HorizontalScrollMode="Enabled"
                          MaxZoomFactor="2"
                          MinZoomFactor="0.5"
                          PointerWheelChanged="ContinuousScrollViewer_PointerWheelChanged"
                          VerticalScrollBarVisibility="Auto"
                          VerticalScrollMode="Enabled"
                          ViewChanged="ContinuousScrollViewer_ViewChanged"
                          Visibility="Collapsed"
                          ZoomMode="Enabled">
                <ItemsRepeater x:Name="ContinuousRepeater"
                               ItemTemplate="{StaticResource ContinuousPageTemplate}"
                               ItemsSource="{x:Bind ViewModel.ContinuousPages, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <StackLayout Orientation="Vertical"
                                     Spacing="8" />
                    </ItemsRepeater.Layout>
                </ItemsRepeater>
            </ScrollViewer>

            <ProgressRing Width="56"
                          Height="56"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
            <TextBlock MaxWidth="600"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="#FFFF7777"
                       Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                       TextAlignment="Center"
                       TextWrapping="Wrap" />

            <Border x:Name="OcrStatusPanel"
                    Padding="14,10"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Background="#DD202020"
                    CornerRadius="16"
                    Visibility="Collapsed">
                <StackPanel MinWidth="260"
                            Spacing="6">
                    <TextBlock x:Name="OcrStatusText"
                               Foreground="White"
                               TextAlignment="Center" />
                    <ProgressBar x:Name="OcrProgressBar"
                                 Maximum="1" />
                </StackPanel>
            </Border>
        </Grid>

        <Canvas x:Name="MangaPopupCanvas"
                Grid.Row="1"
                Canvas.ZIndex="100"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch" />

        <Grid Grid.Row="2"
              Padding="16,4"
              Background="#CC181818">
            <TextBlock VerticalAlignment="Center"
                       Foreground="White"
                       Text="{x:Bind ViewModel.PageStatus, Mode=OneWay}" />
            <StackPanel HorizontalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="10">
                <TextBlock x:Uid="MangaReaderZoomText"
                           VerticalAlignment="Center"
                           Foreground="White"
                           Text="Zoom" />
                <Slider x:Name="ZoomSlider"
                        AutomationProperties.AutomationId="MangaZoomSlider"
                        Width="220"
                        ValueChanged="ZoomSlider_ValueChanged" />
                <TextBlock Width="48"
                           VerticalAlignment="Center"
                           Foreground="White"
                           Text="{x:Bind ViewModel.ZoomPercentage, Mode=OneWay}" />
            </StackPanel>
            <NumberBox x:Name="PageNumberBox"
                       AutomationProperties.AutomationId="MangaPageNumberBox"
                       Width="100"
                       HorizontalAlignment="Right"
                       Minimum="1"
                       SpinButtonPlacementMode="Compact"
                       ValueChanged="PageNumberBox_ValueChanged" />
        </Grid>
    </Grid>
</Window>
